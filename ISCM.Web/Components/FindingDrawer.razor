@using ISCM.Domain.Entities
@using ISCM.Domain.Enums
@using ISCM.Web.Services
@using Microsoft.JSInterop

@if (SelectedFinding != null)
{
    var f = SelectedFinding;

    <div class="fd-overlay" @onclick="CloseDrawer"></div>

    <div class="fd-modal" tabindex="-1" @onkeydown="OnModalKeyDown">

        <div class="fd-header">
            <div class="fd-title-row">
                <div class="fd-title">@f.Name <span class="fd-id">(@f.CheckId)</span></div>
                <button class="fd-close" @onclick="CloseDrawer">X</button>
            </div>
            <div class="fd-badges">
                <span class="fd-badge st-@f.Status.ToString().ToLower()">@f.Status</span>
                <span class="fd-badge sev-@f.Severity.ToString().ToLower()">@f.Severity</span>
                <span class="fd-badge risk @GetRiskClass(f.RiskScore)">Risk @f.RiskScore/100</span>
                @if (!string.IsNullOrEmpty(f.CisReference))
                {
                    <span class="fd-badge cis">@f.CisReference</span>
                }
                <span class="fd-badge cat">@f.Category</span>
            </div>
        </div>

        <div class="fd-actionbar">
            <button class="fd-action @(OpenPanel == PPs ? "active" : "")" @onclick="() => TogglePanel(PPs)">⚡ PowerShell Prompt & Guide</button>
            <button class="fd-action @(OpenPanel == PGraph ? "active" : "")" @onclick="() => TogglePanel(PGraph)">🖱️ Graphical Fix (@GraphTool())</button>
            <button class="fd-action @(OpenPanel == PUndo ? "active" : "")" @onclick="() => TogglePanel(PUndo)">↶ Undo</button>
            <button class="fd-action @(OpenPanel == PRescan ? "active" : "")" @onclick="() => TogglePanel(PRescan)">🔄 Rescan</button>
            <button class="fd-action @(OpenPanel == PIgnore ? "active" : "")" @onclick="() => TogglePanel(PIgnore)">🚫 Ignore</button>
        </div>

        <div class="fd-tabs">
            <button class="fd-tab @(ActiveTab == TabOverview ? "active" : "")" @onclick="() => SetTab(TabOverview)">Overview</button>
            <button class="fd-tab @(ActiveTab == TabSubs ? "active" : "")" @onclick="() => SetTab(TabSubs)">Sub-settings (@SubsFor(f).Count)</button>
            <button class="fd-tab @(ActiveTab == TabSource ? "active" : "")" @onclick="() => SetTab(TabSource)">Source</button>
        </div>

        <div class="fd-body">

            @if (ActiveTab == TabOverview)
            {
                @if (SelectedSubCheck != null)
                {
                    <div class="fd-section">
                        <button class="fd-link" @onclick="BackToSubList">← Back to sub-settings</button>
                        <div class="fd-subtitle">@SelectedSubCheck.Id — @SelectedSubCheck.Title</div>
                    </div>
                }

                @if (OpenPanel == PPs)
                {
                    <div class="fd-panel">
                        <div class="fd-panel-header">⚡ PowerShell Prompt & Guide</div>
                        <div class="fd-row">
                            <div class="fd-row-label">1) Check current state</div>
                            <div class="fd-code"><span>@PsCheck()</span><button class="fd-copy" @onclick="() => CopyText(PsCheck())">Copy</button></div>
                        </div>
                        <div class="fd-row">
                            <div class="fd-row-label">2) Apply (enable / disable)</div>
                            <div class="fd-code"><span>@PsApply()</span><button class="fd-copy" @onclick="() => CopyText(PsApply())">Copy</button></div>
                            @if (!string.IsNullOrEmpty(PsValueMap()))
                            {
                                <div class="fd-note">Value map: @PsValueMap()</div>
                            }
                        </div>
                        <div class="fd-row">
                            <div class="fd-row-label">3) Verify success</div>
                            <div class="fd-code"><span>@PsVerify()</span><button class="fd-copy" @onclick="() => CopyText(PsVerify())">Copy</button></div>
                        </div>
                        @if (!string.IsNullOrEmpty(PsTokens()))
                        {
                            <div class="fd-note">Parameters: @PsTokens()</div>
                        }
                        <div class="fd-actions"><button class="fd-action" @onclick="OpenPowerShell">⚡ Open PowerShell (Admin)</button></div>
                    </div>
                }
                else if (OpenPanel == PGraph)
                {
                    <div class="fd-panel">
                        <div class="fd-panel-header">🖱️ Graphical Fix (@GraphTool())</div>
                        <div class="fd-row"><div class="fd-row-label">Precise path</div><div class="fd-row-value" style="line-height:1.6;">@GraphPath()</div></div>
                        <div class="fd-row"><div class="fd-row-label">Steps</div><div class="fd-row-value" style="line-height:1.7;">@GraphSteps()</div></div>
                        <div class="fd-actions">
                            <button class="fd-action" @onclick="OpenTool">🖱️ Open @GraphTool()</button>
                            @if (SelectedSubCheck != null && SelectedSubCheck.HasRegistryPath)
                            {
                                <button class="fd-action" @onclick="ShowRegistryAlternative">🎯 Jump to Registry</button>
                            }
                        </div>
                        @if (ShowNavGuide)
                        {
                            <div class="fd-row"><div class="fd-row-label">You are here</div><div class="fd-row-value">@(SelectedSubCheck?.YouAreHere ?? "")</div></div>
                            <div class="fd-row"><div class="fd-row-label">Go to</div><div class="glow-target">@(SelectedSubCheck?.GoTo ?? "")</div></div>
                        }
                        @if (ShowRegAlt)
                        {
                            <div class="fd-panel reg-alt">
                                <div class="fd-panel-header" style="color:#ef4444;">🎯 Registry is not recommended</div>
                                <div class="fd-row-value" style="line-height:1.6;">@(SelectedSubCheck?.AlternativeToRegistry ?? "")</div>
                            </div>
                        }
                    </div>
                }
                else if (OpenPanel == PUndo)
                {
                    <div class="fd-panel">
                        <div class="fd-panel-header">↶ Undo (restore original state)</div>
                        <div class="fd-note">@_undoNote</div>
                        <div class="fd-row">
                            <div class="fd-row-label">Reverse command</div>
                            <div class="fd-code"><span>@UndoCli()</span><button class="fd-copy" @onclick="() => CopyText(UndoCli())">Copy</button></div>
                        </div>
                        <div class="fd-row"><div class="fd-row-label">Graphical reverse</div><div class="fd-row-value" style="line-height:1.6;">@GetGraphicalPath(f)</div></div>
                        <div class="fd-actions">
                            <button class="fd-action" @onclick="OpenPowerShell">⚡ Open PowerShell (Admin)</button>
                            <button class="fd-action" @onclick="OpenTool">🖱️ Open @GraphTool()</button>
                        </div>
                    </div>
                }
                else if (OpenPanel == PRescan)
                {
                    <div class="fd-panel">
                        <div class="fd-panel-header">🔄 Rescan</div>
                        <div class="fd-note">@_rescanNote</div>
                        <div class="fd-actions">
                            <button class="fd-action" @onclick="EvaluateRescan">🔄 Rescan this item</button>
                            <button class="fd-action" @onclick="BulkRescan">🔄 Bulk Rescan (@BulkReadyCount ready)</button>
                        </div>
                    </div>
                }
                else if (OpenPanel == PIgnore)
                {
                    <div class="fd-panel">
                        <div class="fd-panel-header">🚫 Ignore this finding</div>
                        <div class="fd-note">@IgnoreConsequence()</div>
                        <div class="fd-actions"><button class="fd-action" @onclick="ConfirmIgnore">🚫 Confirm Ignore</button></div>
                    </div>
                }
                else
                {
                    <div class="fd-panel default">
                        <div class="fd-panel-header">❔ What & Why</div>
                        <div class="fd-value" style="line-height:1.7;">@DefaultDescription()</div>
                        <div class="fd-note">Use the buttons above for PowerShell, graphical fix, undo, rescan, or ignore.</div>
                    </div>
                }
            }
            else if (ActiveTab == TabSubs)
            {
                @if (SubsFor(f).Count == 0)
                {
                    <div class="fd-empty">No sub-settings defined for this finding.</div>
                }
                else
                {
                    <div class="fd-subgrid">
                        @foreach (var sc in SubsFor(f))
                        {
                            var captured = sc;
                            <div class="fd-subrow" @onclick="() => OpenSubFromModal(captured)">
                                <div class="fd-subid">@sc.Id</div>
                                <div class="fd-submain">
                                    <div class="fd-subtitle2">@sc.Title</div>
                                    <div class="fd-subdest">🧭 @sc.DestinationLabel</div>
                                </div>
                                <div class="fd-subexp">Expected: @sc.Expected</div>
                            </div>
                        }
                    </div>
                }
            }
            else if (ActiveTab == TabSource)
            {
                <div class="fd-section"><div class="fd-label">Source Type</div><div class="fd-value">@GetSourceType(f) · Category @f.Category</div></div>
                <div class="fd-section">
                    <div class="fd-label">Source Command</div>
                    <div class="fd-code"><span>@GetSourceCommand(f)</span><button class="fd-copy" @onclick="() => CopyText(GetSourceCommand(f))">Copy</button></div>
                </div>
                @if (!string.IsNullOrEmpty(f.RegistryPath))
                {
                    <div class="fd-section">
                        <div class="fd-label">Registry Path</div>
                        <div class="fd-code"><span>@f.RegistryPath</span><button class="fd-copy" @onclick="() => CopyText(f.RegistryPath!)">Copy</button></div>
                    </div>
                }
            }
        </div>

        <div class="fd-footer">
            <div class="fd-footer-actions">
                <button class="fd-action" @onclick="() => TogglePanel(PUndo)">↶ Undo</button>
                <button class="fd-action" @onclick="() => TogglePanel(PRescan)">🔄 Rescan</button>
                <button class="fd-action" @onclick="() => TogglePanel(PIgnore)">@(f.IsSuppressed ? "🚫 Unignore" : "🚫 Ignore")</button>
            </div>
        </div>
    </div>
}

<style>
    .fd-overlay {
        position: fixed;
        inset: 0;
        background: rgba(2,6,23,0.55);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        z-index: 1000;
    }

    .fd-modal {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%);
        width: min(960px,94vw);
        height: min(760px,90vh);
        background: rgba(30,41,59,0.92);
        backdrop-filter: blur(14px);
        border: 1px solid rgba(6,182,212,0.35);
        border-radius: 16px;
        box-shadow: 0 24px 80px rgba(0,0,0,0.6), 0 0 40px rgba(6,182,212,0.12);
        z-index: 1001;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        outline: none;
        animation: fdIn 0.22s ease-out;
    }

    @@keyframes fdIn {
        from {
            opacity: 0;
            transform: translate(-50%,-50%) scale(0.95);
        }

        to {
            opacity: 1;
            transform: translate(-50%,-50%) scale(1);
        }
    }

    .fd-header {
        flex-shrink: 0;
        padding: 16px 24px 10px;
        border-bottom: 1px solid #334155;
    }

    .fd-title-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .fd-title {
        color: #06b6d4;
        font-size: 18px;
        font-weight: bold;
    }

    .fd-id {
        color: #64748b;
        font-size: 12px;
        font-family: 'Consolas',monospace;
        font-weight: normal;
    }

    .fd-close {
        background: #ef4444;
        color: #fff;
        border: none;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        cursor: pointer;
        font-weight: bold;
        flex-shrink: 0;
    }

    .fd-badges {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        margin-top: 10px;
    }

    .fd-badge {
        font-size: 9px;
        font-weight: bold;
        font-family: 'Consolas',monospace;
        padding: 3px 8px;
        border-radius: 4px;
        border: 1px solid;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .fd-badge.st-pass {
            color: #10b981;
            border-color: rgba(16,185,129,0.5);
        }

        .fd-badge.st-fail {
            color: #ef4444;
            border-color: rgba(239,68,68,0.5);
        }

        .fd-badge.st-warning {
            color: #f59e0b;
            border-color: rgba(245,158,11,0.5);
        }

        .fd-badge.st-ignored, .fd-badge.st-falsepositive {
            color: #94a3b8;
            border-color: #475569;
        }

        .fd-badge.sev-critical {
            color: #ef4444;
            border-color: rgba(239,68,68,0.5);
            background: rgba(239,68,68,0.12);
        }

        .fd-badge.sev-high {
            color: #f59e0b;
            border-color: rgba(245,158,11,0.5);
            background: rgba(245,158,11,0.12);
        }

        .fd-badge.sev-medium {
            color: #e2e8f0;
            border-color: #475569;
        }

        .fd-badge.sev-low {
            color: #94a3b8;
            border-color: #475569;
        }

        .fd-badge.risk {
            color: #e2e8f0;
            border-color: #475569;
        }

        .fd-badge.risk-high {
            color: #ef4444;
            border-color: rgba(239,68,68,0.5);
        }

        .fd-badge.risk-mid {
            color: #f59e0b;
            border-color: rgba(245,158,11,0.5);
        }

        .fd-badge.cis {
            color: #06b6d4;
            border-color: rgba(6,182,212,0.4);
            background: rgba(6,182,212,0.08);
        }

        .fd-badge.cat {
            color: #94a3b8;
            border-color: #475569;
        }

    .fd-actionbar {
        flex-shrink: 0;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        padding: 12px 24px;
        border-bottom: 1px solid #334155;
        background: rgba(15,23,42,0.5);
    }

    .fd-action {
        background: transparent;
        border: 1px solid #334155;
        color: #94a3b8;
        font-size: 12px;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
        font-family: 'Consolas',monospace;
        transition: 0.2s;
        white-space: nowrap;
    }

        .fd-action:hover {
            border-color: #06b6d4;
            color: #06b6d4;
        }

        .fd-action.active {
            border-color: #06b6d4;
            color: #06b6d4;
            background: rgba(6,182,212,0.1);
            box-shadow: 0 0 8px rgba(6,182,212,0.25);
        }

    .fd-tabs {
        flex-shrink: 0;
        display: flex;
        gap: 4px;
        padding: 8px 24px 0;
        border-bottom: 1px solid #334155;
    }

    .fd-tab {
        background: transparent;
        border: 1px solid transparent;
        border-bottom: 2px solid transparent;
        color: #94a3b8;
        font-size: 12px;
        font-weight: bold;
        padding: 8px 16px;
        border-radius: 8px 8px 0 0;
        cursor: pointer;
        transition: 0.2s;
    }

        .fd-tab:hover {
            color: #e2e8f0;
        }

        .fd-tab.active {
            color: #06b6d4;
            border-color: rgba(6,182,212,0.4);
            border-bottom-color: #06b6d4;
            background: rgba(6,182,212,0.08);
        }

    .fd-body {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        padding: 18px 24px;
        scrollbar-width: thin;
        scrollbar-color: #164e63 transparent;
    }

    .fd-section {
        margin-bottom: 16px;
    }

    .fd-label {
        color: #64748b;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 6px;
    }

    .fd-value {
        color: #e2e8f0;
        font-size: 14px;
        line-height: 1.6;
    }

    .fd-subtitle {
        color: #06b6d4;
        font-size: 15px;
        font-weight: bold;
        margin-top: 6px;
    }

    .fd-panel {
        background: rgba(245,158,11,0.04);
        border: 1px solid rgba(245,158,11,0.25);
        border-radius: 10px;
        padding: 14px 16px;
        margin-bottom: 14px;
    }

        .fd-panel.default {
            background: rgba(6,182,212,0.05);
            border-color: rgba(6,182,212,0.3);
        }

        .fd-panel.reg-alt {
            border-color: rgba(239,68,68,0.4);
            background: rgba(239,68,68,0.05);
        }

    .fd-panel-header {
        color: #f59e0b;
        font-weight: bold;
        font-size: 13px;
        margin-bottom: 10px;
    }

    .fd-row {
        margin-bottom: 10px;
    }

    .fd-row-label {
        color: #64748b;
        font-size: 10px;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .fd-row-value {
        color: #e2e8f0;
        font-family: 'Consolas',monospace;
        font-size: 12px;
    }

    .fd-note {
        margin-top: 6px;
        padding: 6px 10px;
        border: 1px dashed #475569;
        border-radius: 6px;
        color: #94a3b8;
        font-size: 11px;
        line-height: 1.6;
    }

    .fd-code {
        background: #0a0e1a;
        border: 1px solid #334155;
        border-radius: 6px;
        padding: 10px 12px;
        font-family: 'Consolas',monospace;
        font-size: 12px;
        color: #7dd3fc;
        word-break: break-all;
        display: flex;
        justify-content: space-between;
        gap: 10px;
        align-items: center;
    }

    .fd-copy {
        background: transparent;
        border: 1px solid #334155;
        color: #06b6d4;
        font-size: 10px;
        padding: 3px 8px;
        border-radius: 4px;
        cursor: pointer;
        white-space: nowrap;
    }

    .fd-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 10px;
    }

    .fd-link {
        background: none;
        border: none;
        color: #06b6d4;
        font-size: 11px;
        cursor: pointer;
        font-weight: bold;
    }

    .glow-target {
        color: #06b6d4;
        font-weight: bold;
        font-family: 'Consolas',monospace;
        font-size: 12px;
        padding: 6px 8px;
        border: 1px dashed rgba(6,182,212,0.5);
        border-radius: 6px;
        animation: fdGlow 1.6s ease-in-out infinite;
    }

    @@keyframes fdGlow {
        0%, 100% {
            text-shadow: 0 0 4px rgba(6,182,212,0.4);
            box-shadow: 0 0 4px rgba(6,182,212,0.2);
        }

        50% {
            text-shadow: 0 0 14px rgba(6,182,212,1);
            box-shadow: 0 0 12px rgba(6,182,212,0.5);
        }
    }

    .fd-subgrid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .fd-subrow {
        display: flex;
        gap: 8px;
        align-items: center;
        background: rgba(15,23,42,0.8);
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 10px 12px;
        cursor: pointer;
        transition: 0.2s;
    }

        .fd-subrow:hover {
            border-color: #06b6d4;
            background: rgba(6,182,212,0.06);
        }

    .fd-subid {
        color: #06b6d4;
        font-family: 'Consolas',monospace;
        font-size: 9px;
        font-weight: bold;
        flex-shrink: 0;
    }

    .fd-submain {
        flex: 1;
        min-width: 0;
    }

    .fd-subtitle2 {
        color: #e2e8f0;
        font-size: 11px;
        font-weight: bold;
    }

    .fd-subdest {
        color: #64748b;
        font-size: 9px;
        margin-top: 2px;
    }

    .fd-subexp {
        color: #94a3b8;
        font-size: 9px;
        font-family: 'Consolas',monospace;
        flex-shrink: 0;
    }

    .fd-empty {
        color: #64748b;
        text-align: center;
        padding: 30px;
        font-size: 12px;
    }

    .fd-footer {
        flex-shrink: 0;
        border-top: 1px solid #334155;
        padding: 12px 24px;
        background: rgba(15,23,42,0.6);
    }

    .fd-footer-actions {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
    }
</style>