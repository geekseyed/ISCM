@using ISCM.Domain.Entities
@using ISCM.Domain.Enums
@using ISCM.Web.Services
@using Microsoft.JSInterop
@using System.Diagnostics
@using Microsoft.Win32

@if (SelectedFinding != null)
{
    var f = SelectedFinding;
    <div class="drawer-overlay active" @onclick="CloseDrawer"></div>
    <div class="drawer open">
        <div class="drawer-header">
            <div class="drawer-title">@f.Name (@f.CheckId)</div>
            <button class="btn-close" @onclick="CloseDrawer">X</button>
        </div>

        @* نوار بالا — powershell حذف شد، ⚡ اضافه شد *@
        <div class="drawer-actions">
            @if (!string.IsNullOrEmpty(CurrentCli))
            {
                <button class="action-btn" @onclick="TogglePsPanel">⚡ PowerShell Prompt & Guide</button>
            }
            @foreach (var tool in GetTools(f))
            {
                var capturedTool = tool;
                <button class="action-btn" @onclick="() => ShowPolicyToolPath(f, capturedTool)">🔧 @capturedTool</button>
            }
            <button class="action-btn" @onclick="ToggleUndoPanel">↶ Undo</button>
            <button class="action-btn" @onclick="RescanFinding">🔄 Rescan</button>
            <button class="action-btn" @onclick="ToggleIgnore">@(f.IsSuppressed ? "🚫 Unignore" : "🚫 Ignore")</button>
        </div>

        @if (!string.IsNullOrEmpty(RescanMessage))
        {
            <div class="rescan-note">@RescanMessage</div>
        }

        @* پنل ⚡ — توصیه → پرامپت → بررسی *@
        @if (ShowPsPanel)
        {
            <div class="tool-panel">
                <div class="tool-panel-header">⚡ PowerShell Prompt & Guide</div>
                <div class="tool-row">
                    <div class="tool-row-label">1) Recommended</div>
                    <div class="tool-row-value" style="line-height:1.6;">@CurrentRecommendation</div>
                </div>
                <div class="tool-row">
                    <div class="tool-row-label">2) Executable Prompt</div>
                    <div class="code-block" style="margin:0;">
                        <span>@CurrentCli</span>
                        <button class="code-copy-btn" @onclick="CopyCurrentCli">Copy</button>
                    </div>
                </div>
                <div class="tool-row">
                    <div class="tool-row-label">3) Verify success</div>
                    <div class="tool-row-value" style="line-height:1.6;">@CurrentVerification</div>
                </div>
            </div>
        }

        <div class="drawer-body">

            @if (SelectedSubCheck != null)
            {
                <div class="detail-section">
                    <button class="link-btn" @onclick="BackToSubList">← Back to finding details</button>
                </div>

                <div class="detail-section">
                    <div class="drawer-title-sub">@SelectedSubCheck.Id — @SelectedSubCheck.Title</div>
                    <div class="detail-value">@SelectedSubCheck.WhatItDoes</div>
                </div>

                <div class="detail-section">
                    <div class="detail-label">1) Recommended</div>
                    <div class="detail-value">@SelectedSubCheck.Recommendation</div>
                </div>

                <div class="detail-section">
                    <div class="detail-label">2) Executable Prompt (PowerShell)</div>
                    <div class="code-block">
                        <span>@SelectedSubCheck.CliCommand</span>
                        <button class="code-copy-btn" @onclick="CopySubCli">Copy</button>
                    </div>
                </div>

                <div class="detail-section">
                    <div class="detail-label">3) Verify success</div>
                    <div class="detail-value">@SelectedSubCheck.Verification</div>
                </div>

                <div class="detail-section">
                    <div class="detail-label">GPO / Console Path</div>
                    <div class="tool-row-value" style="line-height:1.6;">@SelectedSubCheck.ConsolePath</div>
                </div>

                <div class="drawer-actions-sub">
                    <button class="action-btn" @onclick="OpenConsoleWithGuide">🧭 @SelectedSubCheck.DestinationLabel</button>
                    @if (SelectedSubCheck.HasRegistryPath)
                    {
                        <button class="action-btn" @onclick="ShowRegistryAlternative">🎯 Jump to Registry</button>
                    }
                </div>

                @* راهنمای نورانی You are here → Go to *@
                @if (ShowNavGuide)
                {
                    <div class="tool-panel">
                        <div class="tool-panel-header">🧭 Navigation Guide</div>
                        <div class="tool-row">
                            <div class="tool-row-label">You are here</div>
                            <div class="tool-row-value">@SelectedSubCheck.YouAreHere</div>
                        </div>
                        <div class="tool-row">
                            <div class="tool-row-label">Go to</div>
                            <div class="glow-target">@SelectedSubCheck.GoTo</div>
                        </div>
                        <div class="tool-row">
                            <div class="tool-row-label">Steps</div>
                            <div class="tool-row-value" style="line-height:1.7;">@SelectedSubCheck.GraphicalSteps</div>
                        </div>
                    </div>
                }

                @* جایگزین رجیستری — بدون باز کردن regedit *@
                @if (ShowRegAlt)
                {
                    <div class="tool-panel reg-alt">
                        <div class="tool-panel-header" style="color:#ef4444;">🎯 Registry is not recommended</div>
                        <div class="tool-row-value" style="line-height:1.6;">@SelectedSubCheck.AlternativeToRegistry</div>
                    </div>
                }
            }
            else
            {
                <div class="detail-section">
                    <div class="detail-label">Description</div>
                    <div class="detail-value">@(string.IsNullOrEmpty(f.Description) ? "No description available." : f.Description)</div>
                </div>
                <div class="detail-section">
                    <div class="drawer-values">
                        <div>
                            <div class="dv-label">Current</div>
                            <div class="dv-value fv-@f.Status.ToString().ToLower()">@f.CurrentValue</div>
                        </div>
                        <div>
                            <div class="dv-label">Expected</div>
                            <div class="dv-value">@f.ExpectedValue</div>
                        </div>
                    </div>
                </div>
                <div class="detail-section">
                    <div class="drawer-badges-row">
                        @if (!string.IsNullOrEmpty(f.CisReference))
                        {
                            <div>
                                <div class="detail-label">CIS Reference</div>
                                <span class="cis-badge">@f.CisReference</span>
                            </div>
                        }
                        <div>
                            <div class="detail-label">Risk Score</div>
                            <span class="risk-badge @GetRiskClass(f.RiskScore)">Risk: @f.RiskScore/100</span>
                        </div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(f.RegistryPath))
                {
                    <div class="detail-section">
                        <div class="detail-label">Registry Path</div>
                        <div class="code-block">
                            <span>@f.RegistryPath</span>
                            <button class="code-copy-btn" @onclick="() => CopyToClipboard(f.RegistryPath!)">Copy</button>
                        </div>
                    </div>
                }
                <div class="detail-section">
                    <div class="detail-label">Source Type</div>
                    <div class="detail-value">@GetSourceType(f) · Category @f.Category</div>
                </div>
                <div class="detail-section">
                    <div class="detail-label">Source Command</div>
                    <div class="code-block">
                        <span>@GetSourceCommand(f)</span>
                        <button class="code-copy-btn" @onclick="CopySourceCommand">Copy</button>
                    </div>
                </div>
                <div class="detail-section">
                    <div class="detail-label">Recommendation</div>
                    <div class="detail-value">@f.Recommendation</div>
                    @if (f.Status == CheckStatus.Ignored)
                    {
                        <div class="ignored-notice">This finding has been ignored</div>
                    }
                    else if (f.Status == CheckStatus.FalsePositive)
                    {
                        <div class="ignored-notice">This finding has been marked as false positive</div>
                    }
                </div>

                @if (ShowUndoPanel)
                {
                    <div class="tool-panel">
                        <div class="tool-panel-header">↶ Undo Guidance</div>
                        <div class="tool-row">
                            <div class="tool-row-label">CLI Command (PowerShell)</div>
                            <div class="code-block" style="margin: 0;">
                                <span>@GetUndoCliCommand(f)</span>
                                <button class="code-copy-btn" @onclick="() => CopyUndoCommand(f)">Copy</button>
                            </div>
                        </div>
                        <div class="tool-row" style="margin-top: 10px;">
                            <div class="tool-row-label">Graphical Path</div>
                            <div class="tool-row-value" style="line-height: 1.6;">@GetGraphicalPath(f)</div>
                        </div>
                    </div>
                }
                else if (ActiveToolPanel != null)
                {
                    <div class="tool-panel">
                        <div class="tool-panel-header">🔧 Policy Tool Path</div>
                        <div class="tool-row">
                            <div class="tool-row-label">Tool</div>
                            <div class="tool-row-value">@ActiveToolPanel.Tool</div>
                        </div>
                        <div class="tool-row">
                            <div class="tool-row-label">Navigation Path</div>
                            <div class="tool-row-value" style="line-height: 1.6;">@ActiveToolPanel.NavigationPath</div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

<style>
    .drawer-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 1000;
        display: none;
    }

        .drawer-overlay.active {
            display: block;
        }

    .drawer {
        position: fixed;
        top: 0;
        right: 0;
        width: 520px;
        height: 100%;
        background: #1e293b;
        box-shadow: -5px 0 15px rgba(0,0,0,0.5);
        z-index: 1001;
        transform: translateX(100%);
        transition: transform 0.3s ease-in-out;
        padding: 30px;
        overflow: hidden;
        border-left: 2px solid #06b6d4;
        display: flex;
        flex-direction: column;
    }

        .drawer.open {
            transform: translateX(0);
        }

    .drawer-body {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: #164e63 #1e293b;
    }

    .drawer-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #334155;
        padding-bottom: 15px;
        margin-bottom: 12px;
        flex-shrink: 0;
    }

    .drawer-title {
        color: #06b6d4;
        font-size: 18px;
        font-weight: bold;
    }

    .drawer-title-sub {
        color: #06b6d4;
        font-size: 15px;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .btn-close {
        background: #ef4444;
        color: white;
        border: none;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        cursor: pointer;
        font-weight: bold;
        flex-shrink: 0;
    }

    .drawer-actions {
        flex-shrink: 0;
        display: flex;
        gap: 8px;
        justify-content: flex-end;
        align-items: center;
        padding: 0 0 12px 0;
        margin-bottom: 12px;
        border-bottom: 1px solid #334155;
        flex-wrap: wrap;
    }

    .drawer-actions-sub {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 10px;
    }

    .rescan-note {
        flex-shrink: 0;
        margin: 0 0 10px 0;
        padding: 8px 10px;
        border: 1px solid rgba(6,182,212,0.4);
        background: rgba(6,182,212,0.08);
        color: #06b6d4;
        font-size: 11px;
        border-radius: 6px;
    }

    .detail-section {
        margin-bottom: 16px;
        flex-shrink: 0;
    }

    .detail-label {
        color: #64748b;
        font-size: 12px;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .detail-value {
        color: #e2e8f0;
        font-size: 14px;
        line-height: 1.5;
    }

    .ignored-notice {
        display: inline-block;
        background: rgba(148,163,184,0.15);
        border: 1px solid #475569;
        color: #94a3b8;
        font-size: 10px;
        font-weight: bold;
        letter-spacing: 1px;
        padding: 4px 10px;
        border-radius: 4px;
        margin-top: 10px;
        text-transform: uppercase;
    }

    .drawer-values {
        display: flex;
        gap: 30px;
    }

    .dv-label {
        color: #64748b;
        font-size: 10px;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .dv-value {
        font-family: 'Consolas', monospace;
        font-weight: bold;
        color: #e2e8f0;
        font-size: 14px;
    }

    .drawer-badges-row {
        display: flex;
        gap: 30px;
        flex-wrap: wrap;
    }

    .code-block {
        background: #0a0e1a;
        border: 1px solid #334155;
        border-radius: 6px;
        padding: 10px 12px;
        font-family: 'Consolas', monospace;
        font-size: 12px;
        color: #7dd3fc;
        word-break: break-all;
        display: flex;
        justify-content: space-between;
        gap: 10px;
        align-items: center;
    }

    .code-copy-btn {
        background: transparent;
        border: 1px solid #334155;
        color: #06b6d4;
        font-size: 10px;
        padding: 3px 8px;
        border-radius: 4px;
        cursor: pointer;
        white-space: nowrap;
    }

    .tool-panel {
        background: rgba(245,158,11,0.04);
        border: 1px solid rgba(245,158,11,0.25);
        border-radius: 8px;
        padding: 14px;
        margin-bottom: 15px;
    }

        .tool-panel.reg-alt {
            border-color: rgba(239,68,68,0.4);
            background: rgba(239,68,68,0.05);
        }

    .tool-panel-header {
        color: #f59e0b;
        font-weight: bold;
        font-size: 13px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .tool-row {
        display: flex;
        flex-direction: column;
        margin-bottom: 8px;
    }

    .tool-row-label {
        color: #64748b;
        font-size: 10px;
        text-transform: uppercase;
        margin-bottom: 3px;
    }

    .tool-row-value {
        color: #e2e8f0;
        font-family: 'Consolas', monospace;
        font-size: 12px;
    }

    .glow-target {
        color: #06b6d4;
        font-weight: bold;
        font-family: 'Consolas', monospace;
        font-size: 12px;
        padding: 6px 8px;
        border: 1px dashed rgba(6,182,212,0.5);
        border-radius: 6px;
        animation: glowPulse 1.6s ease-in-out infinite;
    }

    @@keyframes glowPulse {
        0%, 100% {
            text-shadow: 0 0 4px rgba(6,182,212,0.4);
            box-shadow: 0 0 4px rgba(6,182,212,0.2);
        }

        50% {
            text-shadow: 0 0 14px rgba(6,182,212,1);
            box-shadow: 0 0 12px rgba(6,182,212,0.5);
        }
    }

    .action-btn {
        background: transparent;
        border: 1px solid #334155;
        color: #94a3b8;
        font-size: 10px;
        padding: 4px 10px;
        border-radius: 4px;
        cursor: pointer;
        font-family: 'Consolas', monospace;
        transition: 0.2s;
        white-space: nowrap;
    }

        .action-btn:hover {
            border-color: #06b6d4;
            color: #06b6d4;
        }

    .link-btn {
        background: none;
        border: none;
        color: #06b6d4;
        font-size: 11px;
        cursor: pointer;
        font-weight: bold;
    }

    .cis-badge {
        color: #06b6d4;
        border: 1px solid rgba(6,182,212,0.4);
        background: rgba(6,182,212,0.08);
        font-family: 'Consolas', monospace;
        font-size: 10px;
        padding: 2px 8px;
        border-radius: 4px;
    }

    .risk-badge {
        font-size: 10px;
        font-family: 'Consolas', monospace;
        padding: 3px 8px;
        border-radius: 4px;
        border: 1px solid;
        white-space: nowrap;
    }

    .risk-low {
        color: #10b981;
        border-color: rgba(16,185,129,0.5);
    }

    .risk-mid {
        color: #f59e0b;
        border-color: rgba(245,158,11,0.5);
    }

    .risk-high {
        color: #ef4444;
        border-color: rgba(239,68,68,0.5);
    }

    .fv-pass {
        color: #10b981;
    }

    .fv-fail {
        color: #ef4444;
    }

    .fv-warning {
        color: #f59e0b;
    }

    .fv-ignored {
        color: #94a3b8;
    }

    .fv-error {
        color: #dc2626;
    }

    .fv-falsepositive {
        color: #a78bfa;
    }
</style>