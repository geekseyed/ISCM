@page "/findings"
@rendermode InteractiveServer
@using ISCM.Domain.Entities
@using ISCM.Domain.Enums
@using ISCM.Web.Services
@inject ScanStateService StateService

<PageTitle>DefenDoor - Findings</PageTitle>

<style>
    .glass-panel {
        background: rgba(30, 41, 59, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-sizing: border-box;
    }

    /* ── الف: جعبه جستجو با آیکون ───────────────────────────────── */
    .search-wrap {
        position: relative;
        margin-bottom: 15px;
        flex-shrink: 0;
    }

    .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        align-items: center;
        pointer-events: none;
    }

    .search-box {
        background: #0f172a;
        border: 1px solid #334155;
        padding: 10px 15px 10px 36px;
        border-radius: 6px;
        color: white;
        width: 100%;
        box-sizing: border-box;
        font-size: 13px;
    }

        .search-box::placeholder {
            color: #64748b;
        }

    /* ── الف۲: تب‌های فیلتر وضعیت با شمارنده ─────────────────────── */
    .filter-tabs {
        display: flex;
        gap: 20px;
        border-bottom: 1px solid #1e293b;
        margin-bottom: 12px;
        flex-shrink: 0;
    }

    .filter-tab {
        background: none;
        border: none;
        color: #94a3b8;
        font-weight: bold;
        font-size: 13px;
        padding: 8px 4px;
        cursor: pointer;
        border-bottom: 2px solid transparent;
        text-transform: uppercase;
        transition: 0.2s;
    }

        .filter-tab:hover {
            color: #e2e8f0;
        }

        .filter-tab.active {
            color: #e2e8f0;
            border-bottom-color: #06b6d4;
        }

    .ft-count {
        color: #64748b;
        font-family: 'Consolas', monospace;
        font-size: 12px;
        margin-left: 5px;
    }

    .filter-tab.active .ft-count {
        color: #06b6d4;
    }

    /* ── الف۳: ردیف دسته‌بندی + دکمه Back ────────────────────────── */
    .category-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
        flex-shrink: 0;
    }

    .cat-links {
        display: flex;
        gap: 16px;
    }

    .cat-link {
        background: none;
        border: none;
        color: #64748b;
        font-size: 12px;
        font-weight: bold;
        cursor: pointer;
        padding: 4px 2px;
        transition: 0.2s;
    }

        .cat-link:hover {
            color: #94a3b8;
        }

        .cat-link.active {
            color: #e2e8f0;
        }

    .btn-back {
        background: #334155;
        border: none;
        padding: 8px 20px;
        color: #06b6d4;
        font-weight: bold;
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
        font-size: 12px;
    }

    /* ── جدول موقت (در مرحله «ب» با کارت‌ها جایگزین می‌شود) ──────── */
    .table-container {
        flex-grow: 1;
        overflow-y: auto;
        border: 1px solid #1e293b;
        border-radius: 8px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        text-align: left;
        padding: 10px;
        background: #0f172a;
        color: #06b6d4;
        border-bottom: 2px solid #334155;
        position: sticky;
        top: 0;
        z-index: 1;
        font-size: 13px;
    }

    td {
        padding: 10px;
        border-bottom: 1px solid #334155;
        font-size: 13px;
    }

    tr {
        cursor: pointer;
        transition: 0.2s;
    }

        tr:hover {
            background-color: rgba(6, 182, 212, 0.05);
        }

    .status-pass {
        color: #10b981;
        font-weight: bold;
        background: rgba(16, 185, 129, 0.1);
        padding: 4px 8px;
        border-radius: 4px;
    }

    .status-fail {
        color: #ef4444;
        font-weight: bold;
        background: rgba(239, 68, 68, 0.1);
        padding: 4px 8px;
        border-radius: 4px;
    }

    .status-warning {
        color: #f59e0b;
        font-weight: bold;
        background: rgba(245, 158, 11, 0.1);
        padding: 4px 8px;
        border-radius: 4px;
    }

    .status-ignored {
        color: #94a3b8;
        font-weight: bold;
        background: rgba(148, 163, 184, 0.1);
        padding: 4px 8px;
        border-radius: 4px;
    }

    .sev-high {
        color: #ef4444;
        font-weight: bold;
    }

    .sev-critical {
        color: #dc2626;
        font-weight: bold;
    }

    .sev-medium {
        color: #f59e0b;
    }

    .sev-low {
        color: #94a3b8;
    }

    .fix-method {
        color: #06b6d4;
        font-family: monospace;
        font-size: 11px;
        cursor: pointer;
        text-decoration: underline;
    }

    .empty-state {
        color: #64748b;
        text-align: center;
        padding: 40px;
        font-size: 13px;
    }

    /* ── Drawer فعلی (در مرحله «ج» به نسخه ۲ ارتقا می‌یابد) ─────── */
    .drawer-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 1000;
        display: none;
    }

        .drawer-overlay.active {
            display: block;
        }

    .drawer {
        position: fixed;
        top: 0;
        right: 0;
        width: 450px;
        height: 100%;
        background: #1e293b;
        box-shadow: -5px 0 15px rgba(0,0,0,0.5);
        z-index: 1001;
        transform: translateX(100%);
        transition: transform 0.3s ease-in-out;
        padding: 30px;
        overflow-y: auto;
        border-left: 2px solid #06b6d4;
    }

        .drawer.open {
            transform: translateX(0);
        }

    .drawer-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #334155;
        padding-bottom: 15px;
        margin-bottom: 20px;
    }

    .drawer-title {
        color: #06b6d4;
        font-size: 20px;
        font-weight: bold;
    }

    .btn-close {
        background: #ef4444;
        color: white;
        border: none;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        cursor: pointer;
        font-weight: bold;
    }

    .detail-section {
        margin-bottom: 20px;
    }

    .detail-label {
        color: #64748b;
        font-size: 12px;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .detail-value {
        color: #e2e8f0;
        font-size: 14px;
        line-height: 1.5;
    }

    .btn-ignore {
        background: #f59e0b;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: bold;
        width: 100%;
        margin-top: 20px;
    }

        .btn-ignore:disabled {
            background: #475569;
            cursor: not-allowed;
        }
</style>

<div class="glass-panel">

    @* ── الف: جستجو با آیکون و placeholder دقیق طرح ── *@
    <div class="search-wrap">
        <span class="search-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7" />
                <line x1="21" y1="21" x2="16.5" y2="16.5" />
            </svg>
        </span>
        <input type="text" class="search-box" placeholder="Search findings..." @bind="SearchTerm" @bind:event="oninput" />
    </div>

    @* ── الف۲: تب‌های فیلتر وضعیت با شمارنده زنده + WARN ── *@
    <div class="filter-tabs">
        <button class="filter-tab @(SelectedFilter == "All" ? "active" : "")" @onclick="SetFilterAll">All <span class="ft-count">@CountAll</span></button>
        <button class="filter-tab @(SelectedFilter == "Fail" ? "active" : "")" @onclick="SetFilterFail">Fail <span class="ft-count">@CountFail</span></button>
        <button class="filter-tab @(SelectedFilter == "Warning" ? "active" : "")" @onclick="SetFilterWarn">Warn <span class="ft-count">@CountWarn</span></button>
        <button class="filter-tab @(SelectedFilter == "Pass" ? "active" : "")" @onclick="SetFilterPass">Pass <span class="ft-count">@CountPass</span></button>
    </div>

    @* ── الف: ردیف دسته‌بندی + Back در سمت راست ── *@
    <div class="category-row">
        <div class="cat-links">
            <button class="cat-link @(string.IsNullOrEmpty(SelectedCategory) ? "active" : "")" @onclick="() => SetCategory(null)">All Categories</button>
            @foreach (var cat in AllCategories)
            {
                <button class="cat-link @(SelectedCategory == cat ? "active" : "")" @onclick="() => SetCategory(cat)">@cat</button>
            }
        </div>
        <a href="/" class="btn-back">← Back to Dashboard</a>
    </div>

    @if (StateService.CurrentScanResult == null)
    {
        <p class="empty-state">Run a scan from the Dashboard to see findings.</p>
    }
    else if (!FilteredFindings.Any())
    {
        <p class="empty-state">No findings match the current filters.</p>
    }
    else
    {
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Severity</th>
                        <th>Fix Method</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var finding in FilteredFindings)
                    {
                        <tr @onclick="() => OpenDrawer(finding)">
                            <td style="color: #64748b; font-family: monospace;">@finding.CheckId</td>
                            <td>@finding.Name</td>
                            <td><span class="sev-@finding.Severity.ToString().ToLower()">@finding.Severity</span></td>
                            <td><span class="fix-method">@GetFixMethod(finding.CheckId)</span></td>
                            <td><span class="status-@finding.Status.ToString().ToLower()">@finding.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (SelectedFinding != null)
{
    <div class="drawer-overlay active" @onclick="CloseDrawer"></div>
    <div class="drawer open">
        <div class="drawer-header">
            <div class="drawer-title">@SelectedFinding.Name</div>
            <button class="btn-close" @onclick="CloseDrawer">X</button>
        </div>
        <div class="detail-section"><div class="detail-label">Check ID</div><div class="detail-value" style="font-family: monospace; color: #06b6d4;">@SelectedFinding.CheckId</div></div>
        <div class="detail-section"><div class="detail-label">Status & Severity</div><div style="display: flex; gap: 10px; margin-top: 5px;"><span class="status-@SelectedFinding.Status.ToString().ToLower()">@SelectedFinding.Status</span><span style="color: #f59e0b; font-weight: bold;">@SelectedFinding.Severity</span></div></div>
        <div class="detail-section"><div class="detail-label">Expected Value</div><div class="detail-value">@SelectedFinding.ExpectedValue</div></div>
        <div class="detail-section"><div class="detail-label">Current Value</div><div class="detail-value" style="color: #ef4444;">@SelectedFinding.CurrentValue</div></div>
        <div class="detail-section"><div class="detail-label">Recommendation</div><div class="detail-value">@SelectedFinding.Recommendation</div></div>

        @if (SelectedFinding.Status != CheckStatus.Ignored)
        {
            <button class="btn-ignore" @onclick="IgnoreFinding">🚫 Ignore This Finding</button>
        }
        else
        {
            <button class="btn-ignore" disabled>✓ Ignored</button>
        }
    </div>
}

@code {
    // مقادیر داخلی فیلتر وضعیت: All / Fail / Warning / Pass
    private string SelectedFilter = "All";
    private string SearchTerm = "";
    private Finding? SelectedFinding;

    [SupplyParameterFromQuery(Name = "category")]
    public string? SelectedCategory { get; set; }

    // EDIT: لیست دسته‌بندی‌ها برای ردیف فیلتر
    private static readonly List<string> AllCategories =
        Enum.GetValues(typeof(CheckCategory)).Cast<CheckCategory>().Select(c => c.ToString()).ToList();

    // EDIT: فیلتر پایه (دسته‌بندی + جستجو) بدون فیلتر وضعیت —
    // مبنای محاسبه شمارنده‌ها و لیست نهایی
    private IEnumerable<Finding> BaseFilteredFindings
    {
        get
        {
            if (StateService.CurrentScanResult == null) return Enumerable.Empty<Finding>();
            var findings = StateService.CurrentScanResult.Findings.AsEnumerable();
            if (!string.IsNullOrEmpty(SelectedCategory))
                findings = findings.Where(f => f.Category.ToString() == SelectedCategory);
            if (!string.IsNullOrWhiteSpace(SearchTerm))
                findings = findings.Where(f => f.Name.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)
                                            || f.CheckId.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase));
            return findings;
        }
    }

    // EDIT: شمارنده‌های زنده تب‌ها (روی فیلتر پایه، قبل از فیلتر وضعیت)
    private int CountAll => BaseFilteredFindings.Count();
    private int CountFail => BaseFilteredFindings.Count(f => f.Status == CheckStatus.Fail);
    private int CountWarn => BaseFilteredFindings.Count(f => f.Status == CheckStatus.Warning);
    private int CountPass => BaseFilteredFindings.Count(f => f.Status == CheckStatus.Pass);

    private IEnumerable<Finding> FilteredFindings
    {
        get
        {
            var findings = BaseFilteredFindings;
            if (SelectedFilter != "All")
                findings = findings.Where(f => f.Status.ToString() == SelectedFilter);
            return findings;
        }
    }

    // استخراج ابزار رفع مشکل از روی آیدی چک
    private string GetFixMethod(string checkId)
    {
        if (checkId.StartsWith("FW") || checkId.StartsWith("SMB")) return "powershell.exe";
        if (checkId.StartsWith("GUEST") || checkId.StartsWith("ADM")) return "net.exe";
        if (checkId.StartsWith("PWD") || checkId.StartsWith("AUD")) return "secpol.msc";
        return "regedit.exe";
    }

    private void SetFilterAll() => SelectedFilter = "All";
    private void SetFilterPass() => SelectedFilter = "Pass";
    private void SetFilterFail() => SelectedFilter = "Fail";
    private void SetFilterWarn() => SelectedFilter = "Warning";

    // EDIT: انتخاب دسته‌بندی از ردیف جدید (null یعنی All Categories)
    private void SetCategory(string? category) => SelectedCategory = category;

    private void OpenDrawer(Finding finding) => SelectedFinding = finding;
    private void CloseDrawer() => SelectedFinding = null;

    private void IgnoreFinding()
    {
        if (SelectedFinding != null)
        {
            SelectedFinding.Ignore(); // فراخوانی متد از لایه Domain
            StateService.LogAction($"User ignored finding: {SelectedFinding.CheckId}");
            StateHasChanged();
        }
    }
}