    private async Task ExportFilteredCsv()
    {
        var items = FinalFindings.ToList();
        await DownloadFindingsAsCsv(items, $"DefenDoor_Findings_Filtered_{DateTime.Now:yyyyMMdd_HHmmss}.csv");
    }

    private async Task DownloadFindingsAsCsv(List<Finding> items, string filename)
    {
        var sb = new StringBuilder();
        sb.AppendLine("CheckId,Name,Category,Severity,Status,Current,Expected,CIS,Risk,Source");
        foreach (var f in items)
        {
            sb.AppendLine($"\"{f.CheckId}\",\"{f.Name}\",\"{f.Category}\",\"{f.Severity}\",\"{f.Status}\",\"{f.CurrentValue}\",\"{f.ExpectedValue}\",\"{f.CisReference}\",{f.RiskScore},\"{f.SourceType}\"");
        }
        await DownloadFile(filename, sb.ToString(), "text/csv");
    }

    private async Task ExportFilteredJson()
    {
        var items = FinalFindings.Select(f => new
        {
            f.CheckId,
            f.Name,
            Category = f.Category.ToString(),
            Severity = f.Severity.ToString(),
            Status = f.Status.ToString(),
            f.CurrentValue,
            f.ExpectedValue,
            f.CisReference,
            f.RiskScore,
            f.SourceType,
            f.SourceCommand,
            f.RegistryPath,
            f.Recommendation
        }).ToList();
        var json = JsonSerializer.Serialize(items, new JsonSerializerOptions { WriteIndented = true });
        await DownloadFile($"DefenDoor_Findings_Filtered_{DateTime.Now:yyyyMMdd_HHmmss}.json", json, "application/json");
    }

    private async Task DownloadFile(string filename, string content, string mime)
    {
        try
        {
            var bytes = Encoding.UTF8.GetBytes(content);
            var b64 = Convert.ToBase64String(bytes);
            var script = $@"(function() {{
                const a = document.createElement('a');
                a.href = 'data:{mime};base64,{b64}';
                a.download = '{filename}';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            }})();";
            await JS.InvokeVoidAsync("eval", script);
        }
        catch (Exception ex)
        {
            StateService.LogAction($"Export failed: {ex.Message}");
        }
    }

    protected override void OnInitialized()
    {
        StateService.OnChange += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        StateService.OnChange -= HandleStateChanged;
    }
