@page "/findings"
@rendermode InteractiveServer
@using System.Text
@using Microsoft.JSInterop
@using ISCM.Domain.Entities
@using ISCM.Domain.Enums
@using ISCM.Web.Services
@using ISCM.Application.Interfaces
@inject ScanStateService StateService
@inject IJSRuntime JS
@inject IControlEvaluator ControlEvaluator
@inject IRemediationService RemediationService
@implements IDisposable

<PageTitle>DefenDoor - Findings</PageTitle>

<style>
    .glass-panel {
        background: rgba(30,41,59,0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 8px 32px 0 rgba(0,0,0,0.37);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-sizing: border-box;
    }

    .stats-tabs {
        display: flex;
        gap: 12px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .stat-tab {
        background: rgba(15,23,42,0.6);
        border: 1px solid #334155;
        border-radius: 10px;
        padding: 14px 20px;
        cursor: pointer;
        transition: 0.2s;
        min-width: 140px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .stat-tab:hover {
            border-color: #06b6d4;
            transform: translateY(-2px);
        }

        .stat-tab.active {
            border-color: #06b6d4;
            background: rgba(6,182,212,0.12);
            box-shadow: 0 0 12px rgba(6,182,212,0.2);
        }

    .stat-value {
        font-size: 28px;
        font-weight: 800;
        font-family: 'Consolas', monospace;
        color: #e2e8f0;
        line-height: 1;
    }

    .stat-label {
        font-size: 11px;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .stat-tab.all {
        border-left: 4px solid #06b6d4;
    }

    .stat-tab.baseline {
        border-left: 4px solid #8b5cf6;
    }

    .stat-tab.extended {
        border-left: 4px solid #0891b2;
    }

    .stat-tab.fail {
        border-left: 4px solid #ef4444;
    }

    .stat-tab.pass {
        border-left: 4px solid #10b981;
    }

    .stat-tab.unknown {
        border-left: 4px solid #f59e0b;
    }

    .search-wrap {
        position: relative;
        margin-bottom: 14px;
    }

    .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
    }

    .search-box {
        background: #0f172a;
        border: 1px solid #334155;
        padding: 10px 15px 10px 36px;
        border-radius: 6px;
        color: white;
        width: 100%;
        box-sizing: border-box;
        font-size: 13px;
    }

        .search-box::placeholder {
            color: #64748b;
        }

    .bulk-bar {
        display: none;
        gap: 10px;
        align-items: center;
        background: rgba(6,182,212,0.08);
        border: 1px solid rgba(6,182,212,0.3);
        border-radius: 8px;
        padding: 8px 14px;
        margin-bottom: 12px;
    }

        .bulk-bar.visible {
            display: flex;
        }

    .bulk-count {
        color: #06b6d4;
        font-family: 'Consolas', monospace;
        font-weight: bold;
        font-size: 13px;
    }

    .bulk-btn {
        background: #1e293b;
        border: 1px solid #334155;
        color: #e2e8f0;
        font-size: 11px;
        padding: 5px 12px;
        border-radius: 4px;
        cursor: pointer;
        transition: 0.2s;
    }

        .bulk-btn:hover {
            border-color: #06b6d4;
        }

        .bulk-btn.clear {
            margin-left: auto;
            background: transparent;
            color: #94a3b8;
        }

    .category-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .cat-links {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }

    .cat-link {
        background: none;
        border: none;
        color: #64748b;
        font-size: 12px;
        font-weight: bold;
        cursor: pointer;
        padding: 4px 2px;
        transition: 0.2s;
    }

        .cat-link:hover {
            color: #94a3b8;
        }

        .cat-link.active {
            color: #e2e8f0;
        }

    .btn-back {
        background: #334155;
        border: none;
        padding: 8px 20px;
        color: #06b6d4;
        font-weight: bold;
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
        font-size: 12px;
    }

    .findings-list {
        flex-grow: 1;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 10px;
        scrollbar-width: thin;
        scrollbar-color: #164e63 #0f172a;
    }

    .finding-card {
        display: flex;
        align-items: center;
        gap: 14px;
        background: rgba(15,23,42,0.6);
        border: 1px solid #1e293b;
        border-left: 3px solid #334155;
        border-radius: 8px;
        padding: 12px 14px;
        cursor: pointer;
        transition: 0.2s;
        flex-wrap: wrap;
    }

        .finding-card:hover {
            background: rgba(6,182,212,0.05);
            border-color: #06b6d4;
        }

        .finding-card.selected {
            background: rgba(6,182,212,0.08);
            border-color: #06b6d4;
        }

    .border-pass {
        border-left-color: #10b981 !important;
    }

    .border-fail {
        border-left-color: #ef4444 !important;
    }

    .border-warning {
        border-left-color: #f59e0b !important;
    }

    .border-ignored {
        border-left-color: #94a3b8 !important;
    }

    .border-error {
        border-left-color: #dc2626 !important;
    }

    .border-falsepositive {
        border-left-color: #a78bfa !important;
    }

    .border-unknown {
        border-left-color: #f59e0b !important;
    }

    .finding-checkbox {
        width: 14px;
        height: 14px;
        border: 2px solid #475569;
        border-radius: 3px;
        cursor: pointer;
        flex-shrink: 0;
        transition: 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
    }

        .finding-checkbox.checked {
            background: #06b6d4;
            border-color: #06b6d4;
        }

            .finding-checkbox.checked::after {
                content: "✓";
                color: white;
                font-weight: bold;
            }

    .finding-main {
        flex: 1 1 260px;
        min-width: 0;
        cursor: pointer;
    }

    .finding-title-row {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .finding-name {
        color: #e2e8f0;
        font-weight: bold;
        font-size: 13px;
    }

    .finding-id {
        color: #64748b;
        font-family: 'Consolas', monospace;
        font-size: 11px;
    }

    .cis-badge {
        color: #0891b2;
        border: 1px solid rgba(8,145,178,0.4);
        background: rgba(8,145,178,0.08);
        font-family: 'Consolas', monospace;
        font-size: 10px;
        padding: 2px 8px;
        border-radius: 4px;
    }

    .fp-tag {
        color: #a78bfa;
        border: 1px solid rgba(167,139,250,0.4);
        background: rgba(167,139,250,0.1);
        font-family: 'Consolas', monospace;
        font-size: 10px;
        padding: 2px 6px;
        border-radius: 3px;
        font-weight: bold;
    }

    .ignored-badge {
        color: #94a3b8;
        border: 1px solid rgba(148,163,184,0.4);
        background: rgba(148,163,184,0.1);
        font-family: 'Consolas', monospace;
        font-size: 10px;
        padding: 2px 6px;
        border-radius: 3px;
        font-weight: bold;
    }

    .mndchi-badge {
        color: #8b5cf6;
        border: 1px solid rgba(139,92,246,0.4);
        background: rgba(139,92,246,0.1);
        font-family: 'Consolas', monospace;
        font-size: 10px;
        padding: 2px 6px;
        border-radius: 3px;
        font-weight: bold;
    }

    .finding-source {
        color: #64748b;
        font-size: 11px;
        margin-top: 4px;
        font-family: 'Consolas', monospace;
    }

    .finding-badges {
        display: flex;
        gap: 6px;
        align-items: center;
        flex-wrap: wrap;
    }

    .status-pass {
        color: #10b981;
        font-weight: bold;
        background: rgba(16,185,129,0.1);
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 10px;
    }

    .status-fail {
        color: #ef4444;
        font-weight: bold;
        background: rgba(239,68,68,0.1);
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 10px;
    }

    .status-warning {
        color: #f59e0b;
        font-weight: bold;
        background: rgba(245,158,11,0.1);
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 10px;
    }

    .status-ignored {
        color: #94a3b8;
        font-weight: bold;
        background: rgba(148,163,184,0.1);
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 10px;
    }

    .status-error {
        color: #dc2626;
        font-weight: bold;
        background: rgba(220,38,38,0.1);
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 10px;
    }

    .status-falsepositive {
        color: #a78bfa;
        font-weight: bold;
        background: rgba(167,139,250,0.1);
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 10px;
    }

    .status-unknown {
        color: #f59e0b;
        font-weight: bold;
        background: rgba(245,158,11,0.1);
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 10px;
    }

    .sev-badge {
        font-size: 10px;
        font-weight: bold;
        padding: 3px 8px;
        border-radius: 4px;
        text-transform: uppercase;
    }

        .sev-badge.low {
            color: #94a3b8;
            background: rgba(148,163,184,0.12);
        }

        .sev-badge.medium {
            color: #e2e8f0;
            background: rgba(226,232,240,0.12);
        }

        .sev-badge.high {
            color: #f59e0b;
            background: rgba(245,158,11,0.12);
        }

        .sev-badge.critical {
            color: #ef4444;
            background: rgba(239,68,68,0.15);
        }

    .empty-state {
        color: #64748b;
        text-align: center;
        padding: 40px;
        font-size: 13px;
    }

    .finding-wrap {
        display: flex;
        flex-direction: column;
    }

    .sub-toggle {
        background: rgba(6,182,212,0.1);
        border: 1px solid rgba(6,182,212,0.4);
        color: #06b6d4;
        font-size: 9px;
        font-weight: bold;
        font-family: 'Consolas', monospace;
        padding: 3px 8px;
        border-radius: 4px;
        cursor: pointer;
        flex-shrink: 0;
    }

    .sub-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
        margin: 6px 0 10px 24px;
    }

    .sub-row {
        display: flex;
        gap: 8px;
        align-items: center;
        background: rgba(15,23,42,0.8);
        border: 1px solid #334155;
        border-radius: 6px;
        padding: 8px 10px;
        cursor: pointer;
        transition: 0.2s;
    }

        .sub-row:hover {
            border-color: #06b6d4;
            background: rgba(6,182,212,0.06);
        }

    .subcheck-id {
        color: #06b6d4;
        font-family: 'Consolas', monospace;
        font-size: 9px;
        font-weight: bold;
        flex-shrink: 0;
    }

    .subcheck-main {
        flex: 1;
        min-width: 0;
    }

    .subcheck-title {
        color: #e2e8f0;
        font-size: 11px;
        font-weight: bold;
    }

    .subcheck-dest {
        color: #64748b;
        font-size: 9px;
        margin-top: 2px;
    }

    .subcheck-expected {
        color: #94a3b8;
        font-size: 9px;
        font-family: 'Consolas', monospace;
        flex-shrink: 0;
    }

    /* ✅ Phase 4.4: استایل دکمه Remediate */
    .remediate-btn {
        background: #10b981;
        color: white;
        border: none;
        font-size: 11px;
        font-weight: bold;
        padding: 5px 12px;
        border-radius: 4px;
        cursor: pointer;
        transition: 0.2s;
        display: flex;
        align-items: center;
        gap: 4px;
    }

        .remediate-btn:hover {
            background: #059669;
            transform: translateY(-1px);
        }

    /* ✅ Phase 4.4: استایل Modal */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.7);
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-content {
        background: #1e293b;
        border: 1px solid #06b6d4;
        border-radius: 12px;
        padding: 24px;
        max-width: 500px;
        width: 90%;
        box-shadow: 0 0 30px rgba(6,182,212,0.3);
    }

    .modal-title {
        color: #06b6d4;
        margin-bottom: 16px;
        font-family: 'Consolas', monospace;
        font-size: 18px;
    }

    .modal-field {
        margin-bottom: 12px;
    }

    .modal-label {
        color: #94a3b8;
        font-weight: bold;
        font-size: 12px;
    }

    .modal-value {
        color: #e2e8f0;
        font-size: 13px;
        margin-top: 4px;
    }

    .modal-warning {
        color: #f59e0b;
        background: rgba(245,158,11,0.1);
        padding: 8px;
        border-radius: 4px;
        margin-bottom: 12px;
        font-size: 12px;
    }

    .modal-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
        margin-top: 20px;
    }

    .modal-btn-cancel {
        background: #475569;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: bold;
    }

    .modal-btn-confirm {
        background: #10b981;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: bold;
    }

        .modal-btn-confirm:hover {
            background: #059669;
        }
</style>

<div class="glass-panel">
    <div class="stats-tabs">
        <div class="stat-tab all @(SelectedFilter == "All" ? "active" : "")" @onclick="SetFilterAll">
            <div class="stat-value">@CountAll</div>
            <div class="stat-label">All Controls</div>
        </div>
        <div class="stat-tab baseline @(SelectedFilter == "Baseline" ? "active" : "")" @onclick="SetFilterBaseline">
            <div class="stat-value">@CountBaseline</div>
            <div class="stat-label">Baseline</div>
        </div>
        <div class="stat-tab extended @(SelectedFilter == "Extended" ? "active" : "")" @onclick="SetFilterExtended">
            <div class="stat-value">@CountExtended</div>
            <div class="stat-label">Extended</div>
        </div>
        <div class="stat-tab fail @(SelectedFilter == "Fail" ? "active" : "")" @onclick="SetFilterFail">
            <div class="stat-value">@CountFail</div>
            <div class="stat-label">Fail</div>
        </div>
        <div class="stat-tab pass @(SelectedFilter == "Pass" ? "active" : "")" @onclick="SetFilterPass">
            <div class="stat-value">@CountPass</div>
            <div class="stat-label">Pass</div>
        </div>
        <div class="stat-tab unknown @(SelectedFilter == "Unknown" ? "active" : "")" @onclick="SetFilterUnknown">
            <div class="stat-value">@CountUnknown</div>
            <div class="stat-label">Unknown</div>
        </div>
    </div>

    <div class="search-wrap">
        <span class="search-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7" />
                <line x1="21" y1="21" x2="16.5" y2="16.5" />
            </svg>
        </span>
        <input type="text" class="search-box" placeholder="Search findings..." @bind="SearchTerm" @bind:event="oninput" />
    </div>

    <div class="bulk-bar @(SelectedFindingIds.Count > 0 ? "visible" : "")">
        <span class="bulk-count">@SelectedFindingIds.Count selected</span>
        <button class="bulk-btn" @onclick="BulkRescan">🔄 Rescan</button>
        <button class="bulk-btn" @onclick="BulkIgnore">🚫 Ignore</button>
        <button class="bulk-btn" @onclick="BulkMarkFp">🏳️ Mark FP</button>
        <button class="bulk-btn" @onclick="BulkExport">📤 Export Selected</button>
        <button class="bulk-btn clear" @onclick="ClearSelection">Clear All</button>
    </div>

    @* ✅ تغییر ب: بنر نوتیفیکیشن نتیجه Remediation *@
    @if (!string.IsNullOrEmpty(_remediationNotice))
    {
        <div style="@NoticeStyle padding:10px 14px; border-radius:6px; margin-bottom:12px; display:flex; justify-content:space-between; align-items:center; font-size:12px; font-weight:bold;">
            <span>@_remediationNotice</span>
            <button class="bulk-btn" @onclick="() => _remediationNotice = null">✕</button>
        </div>
    }

    <div class="category-row">
        <div class="cat-links">
            <button class="cat-link @(string.IsNullOrEmpty(SelectedCategory) ? "active" : "")" @onclick="ClearCategory">All Categories</button>
            @foreach (var cat in AllCategories)
            {
                var capturedCat = cat;
                <button class="cat-link @(SelectedCategory == capturedCat ? "active" : "")" @onclick="() => SetCategory(capturedCat)">@capturedCat</button>
            }
        </div>
        <a href="/" class="btn-back">← Back to Dashboard</a>
    </div>

    @if (StateService.CurrentScanResult == null)
    {
        <p class="empty-state">Run a scan from the Dashboard to see findings.</p>
    }
    else if (!FilteredParents.Any())
    {
        <p class="empty-state">No controls match the current filters.</p>
    }
    else
    {
        <div class="findings-list">
            @foreach (var parent in FilteredParents)
            {
                var isExpanded = ExpandedIds.Contains(parent.Definition.ControlId);
                <div class="finding-wrap">
                    <div class="finding-card border-@parent.CalculatedStatus.ToString().ToLower() @(IsSelected(parent) ? "selected" : "")">
                        <div class="finding-checkbox @(IsSelected(parent) ? "checked" : "")"
                             @onclick="() => ToggleSelect(parent)"
                             @onclick:stopPropagation="true"></div>
                        <div class="finding-main" @onclick="() => ToggleExpanded(parent.Definition.ControlId)">
                            <div class="finding-title-row">
                                <span class="finding-name">@parent.Definition.ControlId. @parent.Definition.Title</span>
                                @if (parent.Definition.IsBaseline)
                                {
                                    <span class="mndchi-badge">@parent.Definition.BaselineId</span>
                                }
                                else
                                {
                                    <span class="cis-badge">Extended</span>
                                }
                            </div>
                            <div class="finding-source">@parent.Definition.Description</div>
                        </div>
                        <div class="finding-badges">
                            <span class="status-@parent.CalculatedStatus.ToString().ToLower()">@parent.CalculatedStatus</span>
                            <span class="sev-badge @parent.Definition.Severity.ToString().ToLower()">@parent.Definition.Severity</span>
                        </div>
                        @if (parent.AllSubChecks.Any())
                        {
                            <button class="sub-toggle" @onclick="() => ToggleExpanded(parent.Definition.ControlId)" @onclick:stopPropagation="true">
                                @(isExpanded ? "▾" : "▸") @parent.AllSubChecks.Count sub
                            </button>
                        }

                        @* ✅ Phase 4.4: دکمه Remediate برای Findings با وضعیت Fail *@
                        @if (parent.CalculatedStatus == CheckStatus.Fail)
                        {
                            var availableRemediations = parent.Definition.TechnicalCheckIds
                            .SelectMany(checkId => RemediationService.GetRemediationsForCheck(checkId))
                            .ToList();

                            if (availableRemediations.Any())
                            {
                                <button class="remediate-btn"
                                        @onclick="() => OpenRemediationModal(parent, availableRemediations.First())"
                                        @onclick:stopPropagation="true"
                                        title="Remediate this finding">
                                    🔧 Remediate
                                </button>
                            }
                        }
                    </div>

                    @if (isExpanded && parent.Findings.Any())
                    {
                        <div class="sub-grid">
                            @foreach (var finding in parent.Findings)
                            {
                                var f = finding;
                                <div class="sub-row" @onclick="() => OpenDrawer(f)">
                                    <div class="subcheck-id">@f.CheckId</div>
                                    <div class="subcheck-main">
                                        <div class="subcheck-title">@f.Name</div>
                                        <div class="subcheck-dest">@f.CurrentValue</div>
                                    </div>
                                    <div class="subcheck-expected">Expected: @f.ExpectedValue</div>

                                    <button class="bulk-btn"
                                            @onclick="() => RescanSubControl(parent.Definition.ControlId, f.CheckId)"
                                            @onclick:stopPropagation="true"
                                            title="Rescan this specific setting">
                                        🔄
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@* ✅ Phase 4.4: Modal Remediation *@
@if (_showRemediationModal && _selectedRemediation != null)
{
    <div class="modal-overlay">
        <div class="modal-content">
            <h3 class="modal-title">🔧 Remediation Confirmation</h3>

            <div class="modal-field">
                <div class="modal-label">Control:</div>
                <div class="modal-value">@_selectedRemediation.CheckId</div>
            </div>

            <div class="modal-field">
                <div class="modal-label">Action:</div>
                <div class="modal-value">@_selectedRemediation.Title</div>
            </div>

            <div class="modal-field">
                <div class="modal-label">Description:</div>
                <div class="modal-value">@_selectedRemediation.Description</div>
            </div>

            <div class="modal-field">
                <div class="modal-label">Risk Level:</div>
                <div class="modal-value" style="color: @(_selectedRemediation.RiskLevel == CheckSeverity.Critical ? "#ef4444" : _selectedRemediation.RiskLevel == CheckSeverity.High ? "#f59e0b" : "#10b981"); font-weight: bold;">
                    @_selectedRemediation.RiskLevel
                </div>
            </div>

            @if (_selectedRemediation.RequiresReboot)
            {
                <div class="modal-warning">
                    ⚠️ This remediation requires a system reboot.
                </div>
            }

            @if (_selectedRemediation.Warnings.Any())
            {
                <div class="modal-warning">
                    <strong>Warnings:</strong>
                    <ul style="margin: 8px 0 0 20px;">
                        @foreach (var warning in _selectedRemediation.Warnings)
                        {
                            <li>@warning</li>
                        }
                    </ul>
                </div>
            }

            <div class="modal-actions">
                <button class="modal-btn-cancel" @onclick="CloseRemediationModal">Cancel</button>
                <button class="modal-btn-confirm" @onclick="ExecuteRemediation">✅ Confirm & Execute</button>
            </div>
        </div>
    </div>
}

<FindingDrawer SelectedFinding="SelectedFinding" InitialSubCheck="SelectedSub" Close="OnDrawerClose" />

@code {
    private string SelectedFilter = "All";
    private string SearchTerm = "";
    private HashSet<string> SelectedFindingIds = new();
    private Finding? SelectedFinding;

    [SupplyParameterFromQuery(Name = "category")]
    public string? SelectedCategory { get; set; }

    private static readonly List<string> AllCategories =
        Enum.GetValues(typeof(CheckCategory)).Cast<CheckCategory>().Select(c => c.ToString()).ToList();

    private class ParentControlView
    {
        public ControlDefinition Definition { get; set; } = null!;
        public List<Finding> Findings { get; set; } = new();
        public CheckStatus CalculatedStatus { get; set; }
        public List<SubCheck> AllSubChecks { get; set; } = new();
    }

    // ✅ Phase 4.4: متغیرهای Modal Remediation
    private bool _showRemediationModal = false;
    private RemediationAction? _selectedRemediation;
    private ParentControlView? _selectedParent;
    private bool _isRemediating = false;

    // ✅ تغییر الف: نوتیفیکیشن نتیجه Remediation
    private string? _remediationNotice;
    private string _noticeKind = "warning"; // success | warning | error

    private string NoticeStyle => _noticeKind switch
    {
        "success" => "background:rgba(16,185,129,0.12); border:1px solid rgba(16,185,129,0.5); color:#10b981;",
        "error" => "background:rgba(239,68,68,0.12); border:1px solid rgba(239,68,68,0.5); color:#ef4444;",
        _ => "background:rgba(245,158,11,0.12); border:1px solid rgba(245,158,11,0.5); color:#f59e0b;"
    };

    private List<ParentControlView> GetParentControls()
    {
        if (StateService.CurrentScanResult == null) return new();

        var allFindings = StateService.CurrentScanResult.Findings.ToList();

        var parents = new List<ParentControlView>();

        foreach (var control in ControlCatalog.GetAll())
        {
            var findings = ControlCatalog.GetFindingsForControl(control, allFindings).ToList();

            if (!findings.Any() && !control.IsBaseline) continue;

            var controlResult = ControlEvaluator.EvaluateFromFindings(control, findings);

            var parent = new ParentControlView
                {
                    Definition = control,
                    Findings = findings,
                    CalculatedStatus = controlResult.Status,
                    AllSubChecks = findings.SelectMany(f => f.SubChecks).ToList()
                };

            parents.Add(parent);
        }

        return parents;
    }

    private List<ParentControlView> FilteredParents
    {
        get
        {
            var parents = GetParentControls();

            if (!string.IsNullOrWhiteSpace(SelectedCategory))
            {
                parents = parents.Where(p => p.Definition.Category.ToString() == SelectedCategory).ToList();
            }

            if (SelectedFilter == "Baseline")
            {
                parents = parents.Where(p => p.Definition.IsBaseline).ToList();
            }
            else if (SelectedFilter == "Extended")
            {
                parents = parents.Where(p => !p.Definition.IsBaseline).ToList();
            }
            else if (SelectedFilter == "Fail")
            {
                parents = parents.Where(p => p.CalculatedStatus == CheckStatus.Fail).ToList();
            }
            else if (SelectedFilter == "Pass")
            {
                parents = parents.Where(p => p.CalculatedStatus == CheckStatus.Pass).ToList();
            }
            else if (SelectedFilter == "Unknown")
            {
                parents = parents.Where(p => p.CalculatedStatus == CheckStatus.Unknown).ToList();
            }
            else if (SelectedFilter == "MNDCHI")
            {
                parents = parents.Where(p => p.Definition.IsBaseline).ToList();
            }

            if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                parents = parents.Where(p =>
                    p.Definition.Title.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    p.Definition.Description.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)
                ).ToList();
            }

            return parents
                .OrderBy(p =>
                {
                    if (p.Definition.IsBaseline)
                    {
                        if (int.TryParse(p.Definition.ControlId, out var num))
                            return (0, num);
                        return (0, 999);
                    }
                    else if (p.Definition.ControlId.StartsWith("EXT-"))
                    {
                        return (1, 0);
                    }
                    else if (p.Definition.ControlId.StartsWith("ERDC-"))
                    {
                        return (2, 0);
                    }
                    return (3, 0);
                })
                .ThenBy(p => p.Definition.ControlId)
                .ToList();
        }
    }

    private int CountAll => GetParentControls().Count;
    private int CountBaseline => GetParentControls().Count(p => p.Definition.IsBaseline);
    private int CountExtended => GetParentControls().Count(p => !p.Definition.IsBaseline);
    private int CountFail => GetParentControls().Count(p => p.CalculatedStatus == CheckStatus.Fail);
    private int CountPass => GetParentControls().Count(p => p.CalculatedStatus == CheckStatus.Pass);
    private int CountUnknown => GetParentControls().Count(p => p.CalculatedStatus == CheckStatus.Unknown);
    private int CountMndchi => CountBaseline;

    private bool IsSelected(ParentControlView parent) =>
        parent.Findings.Any(f => SelectedFindingIds.Contains(f.CheckId));

    private void ToggleSelect(ParentControlView parent)
    {
        foreach (var finding in parent.Findings)
        {
            if (!SelectedFindingIds.Add(finding.CheckId))
                SelectedFindingIds.Remove(finding.CheckId);
        }
    }

    private void ClearSelection() => SelectedFindingIds.Clear();

    private IEnumerable<Finding> GetSelectedFindings()
    {
        if (StateService.CurrentScanResult == null) return Enumerable.Empty<Finding>();
        return StateService.CurrentScanResult.Findings.Where(f => SelectedFindingIds.Contains(f.CheckId));
    }

    private async Task BulkRescan()
    {
        foreach (var f in GetSelectedFindings().ToList())
            await StateService.RescanCheckAsync(f.CheckId);
        ClearSelection();
    }

    private void BulkIgnore()
    {
        foreach (var f in GetSelectedFindings())
        {
            if (!f.IsSuppressed) f.Ignore("Bulk ignore via Findings UI", "Operator");
            StateService.LogAction($"User ignored: {f.CheckId}");
        }
        ClearSelection();
    }

    private void BulkMarkFp()
    {
        foreach (var f in GetSelectedFindings())
        {
            f.MarkFalsePositive();
            StateService.LogAction($"User marked FP: {f.CheckId}");
        }
        ClearSelection();
    }

    private async Task BulkExport()
    {
        var items = GetSelectedFindings().ToList();
        if (!items.Any()) return;
        await DownloadFindingsAsCsv(items, $"DefenDoor_Selected_{DateTime.Now:yyyyMMdd_HHmmss}.csv");
    }

    private void SetFilterAll() => SelectedFilter = "All";
    private void SetFilterBaseline() => SelectedFilter = "Baseline";
    private void SetFilterExtended() => SelectedFilter = "Extended";
    private void SetFilterPass() => SelectedFilter = "Pass";
    private void SetFilterFail() => SelectedFilter = "Fail";
    private void SetFilterUnknown() => SelectedFilter = "Unknown";
    private void SetFilterMndchi() => SelectedFilter = "MNDCHI";
    private void SetCategory(string? c) => SelectedCategory = c;
    private void ClearCategory() => SelectedCategory = null;

    private SubCheck? SelectedSub;
    private HashSet<string> ExpandedIds = new();

    private void OpenDrawer(Finding f) { SelectedFinding = f; SelectedSub = null; }
    private void OpenSubDrawer(Finding f, SubCheck sc) { SelectedFinding = f; SelectedSub = sc; }
    private void ToggleExpanded(string id)
    {
        if (!ExpandedIds.Add(id)) ExpandedIds.Remove(id);
    }
    private void OnDrawerClose() { SelectedFinding = null; SelectedSub = null; }

    private async Task RescanSubControl(string controlId, string subControlId)
    {
        await StateService.RescanSubControlAsync(controlId, subControlId);
    }

    // ✅ Phase 4.4: متد باز کردن Modal
    private void OpenRemediationModal(ParentControlView parent, RemediationAction remediation)
    {
        _selectedParent = parent;
        _selectedRemediation = remediation;
        _showRemediationModal = true;
    }

    // ✅ Phase 4.4: متد بستن Modal
    private void CloseRemediationModal()
    {
        _showRemediationModal = false;
        _selectedRemediation = null;
        _selectedParent = null;
    }

    // ✅ تغییر ج: متد اجرای Remediation با منطق تأیید / تذکر ری‌استارت / خطا
    private async Task ExecuteRemediation()
    {
        if (_isRemediating) return;
        var remediation = _selectedRemediation;
        var parent = _selectedParent;
        if (remediation == null || parent == null) return;

        _isRemediating = true;
        _remediationNotice = null;
        CloseRemediationModal();
        StateService.LogConsole($"⏳ Executing remediation: {remediation.Title} ...", "status-info");
        StateHasChanged();

        var targetCheckId = parent.Findings.FirstOrDefault()?.CheckId ?? remediation.CheckId;

        try
        {
            var result = await RemediationService.ExecuteRemediationAsync(remediation.RemediationId, "Admin");

            if (result.Status == RemediationStatus.Success)
            {
                StateService.LogConsole($"✅ Remediation executed: {remediation.Title}", "status-success");
                StateService.LogAction($"Remediation SUCCESS: {remediation.Title} ({targetCheckId})");

                // اسکن پس‌زمینه برای تأیید وضعیت واقعی سیستم
                await StateService.RescanCheckAsync(targetCheckId);
                var newStatus = StateService.CurrentScanResult?.Findings
                    .FirstOrDefault(f => f.CheckId == targetCheckId)?.Status;

                if (newStatus == CheckStatus.Pass)
                {
                    // تأیید شد → دکمه Remediate خودبه‌خود حذف می‌شود (چون وضعیت Pass است)
                    _noticeKind = "success";
                    _remediationNotice = $"✅ {remediation.Title}: applied and verified. The Remediate button is now disabled for this item.";
                    StateService.LogConsole($"🎯 Verification PASSED: {targetCheckId} is now compliant.", "status-success");
                }
                else if (remediation.RequiresReboot)
                {
                    // تذکر ری‌استارت
                    _noticeKind = "warning";
                    _remediationNotice = $"⚠️ {remediation.Title}: applied, but a REBOOT is required. Restart Windows, then run a new scan — the item should be fixed.";
                    StateService.LogConsole($"⚠️ Reboot required for {targetCheckId}.", "status-warning");
                }
                else
                {
                    _noticeKind = "warning";
                    _remediationNotice = $"⚠️ {remediation.Title}: applied, but verification still shows {newStatus}. Run a full scan or check the setting manually.";
                    StateService.LogConsole($"⚠️ Verification still {newStatus} for {targetCheckId}.", "status-warning");
                }
            }
            else
            {
                _noticeKind = "error";
                _remediationNotice = $"❌ {remediation.Title}: failed. {result.ExecutionOutput}";
                StateService.LogConsole($"❌ Remediation failed: {result.ExecutionOutput}", "status-error");
                StateService.LogAction($"Remediation FAILED: {remediation.Title} - {result.ExecutionOutput}");
            }
        }
        catch (Exception ex)
        {
            _noticeKind = "error";
            _remediationNotice = $"❌ Remediation error: {ex.Message}";
            StateService.LogConsole($"❌ Remediation error: {ex.Message}", "status-error");
            StateService.LogAction($"Remediation ERROR: {remediation.Title} - {ex.Message}");
        }
        finally
        {
            _isRemediating = false;
            StateHasChanged();
        }
    }

    private async Task DownloadFindingsAsCsv(List<Finding> items, string filename)
    {
        var sb = new StringBuilder();
        sb.AppendLine("CheckId,Name,Category,Severity,Status,Current,Expected,CIS,Risk,Source");
        foreach (var f in items)
        {
            sb.AppendLine($"\"{f.CheckId}\",\"{f.Name}\",\"{f.Category}\",\"{f.Severity}\",\"{f.Status}\",\"{f.CurrentValue}\",\"{f.ExpectedValue}\",\"{f.CisReference}\",{f.RiskScore},\"{f.SourceType}\"");
        }
        var bytes = Encoding.UTF8.GetBytes(sb.ToString());
        var b64 = Convert.ToBase64String(bytes);
        var script = $@"(function() {{
            const a = document.createElement('a');
            a.href = 'data:text/csv;base64,{b64}';
            a.download = '{filename}';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }})();";
        await JS.InvokeVoidAsync("eval", script);
    }

    protected override void OnInitialized()
    {
        StateService.OnChange += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        StateService.OnChange -= HandleStateChanged;
    }
}