@page "/findings"
@rendermode InteractiveServer
@using ISCM.Domain.Entities
@using ISCM.Domain.Enums
@using ISCM.Web.Services
@inject ScanStateService StateService

<PageTitle>DefenDoor - Findings</PageTitle>

<style>
    .glass-panel {
        background: rgba(30, 41, 59, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-sizing: border-box;
    }

    /* ── نوار بالا (مرحله الف) ──────────────────────────────────── */
    .search-wrap {
        position: relative;
        margin-bottom: 15px;
        flex-shrink: 0;
    }

    .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        align-items: center;
        pointer-events: none;
    }

    .search-box {
        background: #0f172a;
        border: 1px solid #334155;
        padding: 10px 15px 10px 36px;
        border-radius: 6px;
        color: white;
        width: 100%;
        box-sizing: border-box;
        font-size: 13px;
    }

        .search-box::placeholder {
            color: #64748b;
        }

    .filter-tabs {
        display: flex;
        gap: 20px;
        border-bottom: 1px solid #1e293b;
        margin-bottom: 12px;
        flex-shrink: 0;
    }

    .filter-tab {
        background: none;
        border: none;
        color: #94a3b8;
        font-weight: bold;
        font-size: 13px;
        padding: 8px 4px;
        cursor: pointer;
        border-bottom: 2px solid transparent;
        text-transform: uppercase;
        transition: 0.2s;
    }

        .filter-tab:hover {
            color: #e2e8f0;
        }

        .filter-tab.active {
            color: #e2e8f0;
            border-bottom-color: #06b6d4;
        }

    .ft-count {
        color: #64748b;
        font-family: 'Consolas', monospace;
        font-size: 12px;
        margin-left: 5px;
    }

    .filter-tab.active .ft-count {
        color: #06b6d4;
    }

    .category-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
        flex-shrink: 0;
    }

    .cat-links {
        display: flex;
        gap: 16px;
    }

    .cat-link {
        background: none;
        border: none;
        color: #64748b;
        font-size: 12px;
        font-weight: bold;
        cursor: pointer;
        padding: 4px 2px;
        transition: 0.2s;
    }

        .cat-link:hover {
            color: #94a3b8;
        }

        .cat-link.active {
            color: #e2e8f0;
        }

    .btn-back {
        background: #334155;
        border: none;
        padding: 8px 20px;
        color: #06b6d4;
        font-weight: bold;
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
        font-size: 12px;
    }

    /* ── ب: لیست کارت‌های یافته‌ها ───────────────────────────────── */
    .findings-list {
        flex-grow: 1;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 10px;
        scrollbar-width: thin;
        scrollbar-color: #164e63 #0f172a;
    }

    .finding-card {
        display: flex;
        align-items: center;
        gap: 14px;
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid #1e293b;
        border-left: 3px solid #334155;
        border-radius: 8px;
        padding: 12px 14px;
        cursor: pointer;
        transition: 0.2s;
        flex-shrink: 0;
    }

        .finding-card:hover {
            background: rgba(6, 182, 212, 0.05);
            border-color: #06b6d4;
        }

    /* EDIT: نوار رنگی سمت چپ به رنگ وضعیت واقعی */
    .border-pass {
        border-left-color: #10b981 !important;
    }

    .border-fail {
        border-left-color: #ef4444 !important;
    }

    .border-warning {
        border-left-color: #f59e0b !important;
    }

    .border-ignored {
        border-left-color: #94a3b8 !important;
    }

    .border-error {
        border-left-color: #dc2626 !important;
    }

    .finding-main {
        flex: 1 1 260px;
        min-width: 0;
    }

    .finding-title-row {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .finding-name {
        color: #e2e8f0;
        font-weight: bold;
        font-size: 13px;
    }

    .finding-id {
        color: #64748b;
        font-family: 'Consolas', monospace;
        font-size: 11px;
    }

    /* EDIT: بج CIS — فقط وقتی داده واقعی داشته باشیم نمایش داده می‌شود */
    .cis-badge {
        color: #06b6d4;
        border: 1px solid rgba(6, 182, 212, 0.4);
        background: rgba(6, 182, 212, 0.08);
        font-family: 'Consolas', monospace;
        font-size: 10px;
        padding: 2px 8px;
        border-radius: 4px;
    }

    .finding-source {
        color: #64748b;
        font-size: 11px;
        margin-top: 4px;
        font-family: 'Consolas', monospace;
    }

    /* EDIT: نمایش inline مقدار CURRENT (رنگی) و EXPECTED (سفید) */
    .finding-values {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        white-space: nowrap;
    }

    .fv-label {
        color: #64748b;
        font-size: 10px;
        text-transform: uppercase;
    }

    .fv-current {
        font-family: 'Consolas', monospace;
        font-weight: bold;
    }

    .fv-pass {
        color: #10b981;
    }

    .fv-fail {
        color: #ef4444;
    }

    .fv-warning {
        color: #f59e0b;
    }

    .fv-ignored {
        color: #94a3b8;
    }

    .fv-error {
        color: #dc2626;
    }

    .fv-expected {
        color: #e2e8f0;
        font-family: 'Consolas', monospace;
    }

    /* EDIT: دکمه‌های اکشن هر ردیف */
    .finding-actions {
        display: flex;
        gap: 6px;
        align-items: center;
    }

    .action-btn {
        background: transparent;
        border: 1px solid #334155;
        color: #94a3b8;
        font-size: 10px;
        padding: 4px 10px;
        border-radius: 4px;
        cursor: pointer;
        font-family: 'Consolas', monospace;
        transition: 0.2s;
        white-space: nowrap;
    }

        .action-btn:hover:not(:disabled) {
            border-color: #06b6d4;
            color: #06b6d4;
        }

        .action-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

    /* EDIT: بج‌های سمت راست: وضعیت / شدت / ریسک */
    .finding-badges {
        display: flex;
        gap: 6px;
        align-items: center;
    }

    .status-pass {
        color: #10b981;
        font-weight: bold;
        background: rgba(16, 185, 129, 0.1);
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 10px;
    }

    .status-fail {
        color: #ef4444;
        font-weight: bold;
        background: rgba(239, 68, 68, 0.1);
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 10px;
    }

    .status-warning {
        color: #f59e0b;
        font-weight: bold;
        background: rgba(245, 158, 11, 0.1);
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 10px;
    }

    .status-ignored {
        color: #94a3b8;
        font-weight: bold;
        background: rgba(148, 163, 184, 0.1);
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 10px;
    }

    .status-error {
        color: #dc2626;
        font-weight: bold;
        background: rgba(220, 38, 38, 0.1);
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 10px;
    }

    .sev-badge {
        font-size: 10px;
        font-weight: bold;
        padding: 3px 8px;
        border-radius: 4px;
        text-transform: uppercase;
    }

        .sev-badge.low {
            color: #94a3b8;
            background: rgba(148, 163, 184, 0.12);
        }

        .sev-badge.medium {
            color: #e2e8f0;
            background: rgba(226, 232, 240, 0.12);
        }

        .sev-badge.high {
            color: #f59e0b;
            background: rgba(245, 158, 11, 0.12);
        }

        .sev-badge.critical {
            color: #ef4444;
            background: rgba(239, 68, 68, 0.15);
        }

    .risk-badge {
        font-size: 10px;
        font-family: 'Consolas', monospace;
        padding: 3px 8px;
        border-radius: 4px;
        border: 1px solid;
        white-space: nowrap;
    }

    .risk-low {
        color: #10b981;
        border-color: rgba(16, 185, 129, 0.5);
    }

    .risk-mid {
        color: #f59e0b;
        border-color: rgba(245, 158, 11, 0.5);
    }

    .risk-high {
        color: #ef4444;
        border-color: rgba(239, 68, 68, 0.5);
    }

    .empty-state {
        color: #64748b;
        text-align: center;
        padding: 40px;
        font-size: 13px;
    }

    /* ── Drawer فعلی (در مرحله «ج» به نسخه ۲ ارتقا می‌یابد) ─────── */
    .drawer-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 1000;
        display: none;
    }

        .drawer-overlay.active {
            display: block;
        }

    .drawer {
        position: fixed;
        top: 0;
        right: 0;
        width: 450px;
        height: 100%;
        background: #1e293b;
        box-shadow: -5px 0 15px rgba(0,0,0,0.5);
        z-index: 1001;
        transform: translateX(100%);
        transition: transform 0.3s ease-in-out;
        padding: 30px;
        overflow-y: auto;
        border-left: 2px solid #06b6d4;
    }

        .drawer.open {
            transform: translateX(0);
        }

    .drawer-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #334155;
        padding-bottom: 15px;
        margin-bottom: 20px;
    }

    .drawer-title {
        color: #06b6d4;
        font-size: 20px;
        font-weight: bold;
    }

    .btn-close {
        background: #ef4444;
        color: white;
        border: none;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        cursor: pointer;
        font-weight: bold;
    }

    .detail-section {
        margin-bottom: 20px;
    }

    .detail-label {
        color: #64748b;
        font-size: 12px;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .detail-value {
        color: #e2e8f0;
        font-size: 14px;
        line-height: 1.5;
    }

    .btn-ignore {
        background: #f59e0b;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: bold;
        width: 100%;
        margin-top: 20px;
    }

        .btn-ignore:disabled {
            background: #475569;
            cursor: not-allowed;
        }
</style>

<div class="glass-panel">

    @* ── الف: جستجو ── *@
    <div class="search-wrap">
        <span class="search-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7" />
                <line x1="21" y1="21" x2="16.5" y2="16.5" />
            </svg>
        </span>
        <input type="text" class="search-box" placeholder="Search findings..." @bind="SearchTerm" @bind:event="oninput" />
    </div>

    @* ── الف: تب‌های فیلتر وضعیت با شمارنده ── *@
    <div class="filter-tabs">
        <button class="filter-tab @(SelectedFilter == "All" ? "active" : "")" @onclick="SetFilterAll">All <span class="ft-count">@CountAll</span></button>
        <button class="filter-tab @(SelectedFilter == "Fail" ? "active" : "")" @onclick="SetFilterFail">Fail <span class="ft-count">@CountFail</span></button>
        <button class="filter-tab @(SelectedFilter == "Warning" ? "active" : "")" @onclick="SetFilterWarn">Warn <span class="ft-count">@CountWarn</span></button>
        <button class="filter-tab @(SelectedFilter == "Pass" ? "active" : "")" @onclick="SetFilterPass">Pass <span class="ft-count">@CountPass</span></button>
    </div>

    @* ── الف: ردیف دسته‌بندی + Back ── *@
    <div class="category-row">
        <div class="cat-links">
            <button class="cat-link @(string.IsNullOrEmpty(SelectedCategory) ? "active" : "")" @onclick="() => SetCategory(null)">All Categories</button>
            @foreach (var cat in AllCategories)
            {
                <button class="cat-link @(SelectedCategory == cat ? "active" : "")" @onclick="() => SetCategory(cat)">@cat</button>
            }
        </div>
        <a href="/" class="btn-back">← Back to Dashboard</a>
    </div>

    @if (StateService.CurrentScanResult == null)
    {
        <p class="empty-state">Run a scan from the Dashboard to see findings.</p>
    }
    else if (!FilteredFindings.Any())
    {
        <p class="empty-state">No findings match the current filters.</p>
    }
    else
    {
        @* ── ب: لیست کارت‌های یافته‌ها (جایگزین جدول) ── *@
        <div class="findings-list">
            @foreach (var finding in FilteredFindings)
            {
                <div class="finding-card border-@finding.Status.ToString().ToLower()" @onclick="() => OpenDrawer(finding)">

                    <div class="finding-main">
                        <div class="finding-title-row">
                            <span class="finding-name">@finding.Name</span>
                            <span class="finding-id">@finding.CheckId</span>
                            @if (!string.IsNullOrEmpty(finding.CisReference))
                            {
                                <span class="cis-badge">@finding.CisReference</span>
                            }
                        </div>
                        <div class="finding-source">Source: @finding.SourceType · @finding.Category</div>
                    </div>

                    <div class="finding-values">
                        <span class="fv-label">Current</span>
                        <span class="fv-current fv-@finding.Status.ToString().ToLower()">@finding.CurrentValue</span>
                        <span class="fv-label">Expected</span>
                        <span class="fv-expected">@finding.ExpectedValue</span>
                    </div>

                    @* EDIT: stopPropagation تا کلیک روی دکمه‌ها Drawer را باز نکند *@
                    <div class="finding-actions" @onclick:stopPropagation="true">
                        @foreach (var tool in GetTools(finding))
                        {
                            <button class="action-btn" @onclick="() => LaunchTool(tool)">@tool</button>
                        }
                        <button class="action-btn" disabled="@(finding.Status != CheckStatus.Ignored)" @onclick="() => UndoFinding(finding)">Undo</button>
                        <button class="action-btn" @onclick="() => RescanFinding(finding)">Rescan</button>
                        <button class="action-btn" disabled="@(finding.Status == CheckStatus.Ignored)" @onclick="() => IgnoreFindingRow(finding)">Ignore</button>
                    </div>

                    <div class="finding-badges">
                        <span class="status-@finding.Status.ToString().ToLower()">@finding.Status</span>
                        <span class="sev-badge @finding.Severity.ToString().ToLower()">@finding.Severity</span>
                        <span class="risk-badge @GetRiskClass(finding.RiskScore)">Risk @finding.RiskScore</span>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (SelectedFinding != null)
{
    <div class="drawer-overlay active" @onclick="CloseDrawer"></div>
    <div class="drawer open">
        <div class="drawer-header">
            <div class="drawer-title">@SelectedFinding.Name</div>
            <button class="btn-close" @onclick="CloseDrawer">X</button>
        </div>
        <div class="detail-section"><div class="detail-label">Check ID</div><div class="detail-value" style="font-family: monospace; color: #06b6d4;">@SelectedFinding.CheckId</div></div>
        <div class="detail-section"><div class="detail-label">Status & Severity</div><div style="display: flex; gap: 10px; margin-top: 5px;"><span class="status-@SelectedFinding.Status.ToString().ToLower()">@SelectedFinding.Status</span><span style="color: #f59e0b; font-weight: bold;">@SelectedFinding.Severity</span></div></div>
        <div class="detail-section"><div class="detail-label">Expected Value</div><div class="detail-value">@SelectedFinding.ExpectedValue</div></div>
        <div class="detail-section"><div class="detail-label">Current Value</div><div class="detail-value" style="color: #ef4444;">@SelectedFinding.CurrentValue</div></div>
        <div class="detail-section"><div class="detail-label">Recommendation</div><div class="detail-value">@SelectedFinding.Recommendation</div></div>

        @if (SelectedFinding.Status != CheckStatus.Ignored)
        {
            <button class="btn-ignore" @onclick="IgnoreFinding">🚫 Ignore This Finding</button>
        }
        else
        {
            <button class="btn-ignore" disabled>✓ Ignored</button>
        }
    </div>
}

@code {
    private string SelectedFilter = "All";
    private string SearchTerm = "";
    private Finding? SelectedFinding;

    [SupplyParameterFromQuery(Name = "category")]
    public string? SelectedCategory { get; set; }

    private static readonly List<string> AllCategories =
        Enum.GetValues(typeof(CheckCategory)).Cast<CheckCategory>().Select(c => c.ToString()).ToList();

    private IEnumerable<Finding> BaseFilteredFindings
    {
        get
        {
            if (StateService.CurrentScanResult == null) return Enumerable.Empty<Finding>();
            var findings = StateService.CurrentScanResult.Findings.AsEnumerable();
            if (!string.IsNullOrEmpty(SelectedCategory))
                findings = findings.Where(f => f.Category.ToString() == SelectedCategory);
            if (!string.IsNullOrWhiteSpace(SearchTerm))
                findings = findings.Where(f => f.Name.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)
                                            || f.CheckId.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase));
            return findings;
        }
    }

    private int CountAll => BaseFilteredFindings.Count();
    private int CountFail => BaseFilteredFindings.Count(f => f.Status == CheckStatus.Fail);
    private int CountWarn => BaseFilteredFindings.Count(f => f.Status == CheckStatus.Warning);
    private int CountPass => BaseFilteredFindings.Count(f => f.Status == CheckStatus.Pass);

    private IEnumerable<Finding> FilteredFindings
    {
        get
        {
            var findings = BaseFilteredFindings;
            if (SelectedFilter != "All")
                findings = findings.Where(f => f.Status.ToString() == SelectedFilter);
            return findings;
        }
    }

    // استخراج ابزار رفع مشکل از روی آیدی چک (Fallback تا مرحله «د»)
    private string GetFixMethod(string checkId)
    {
        if (checkId.StartsWith("FW") || checkId.StartsWith("SMB")) return "powershell.exe";
        if (checkId.StartsWith("GUEST") || checkId.StartsWith("ADM")) return "net.exe";
        if (checkId.StartsWith("PWD") || checkId.StartsWith("AUD")) return "secpol.msc";
        return "regedit.exe";
    }

    // EDIT: ابزارهای هر ردیف — اگر چک هنوز FixTools واقعی نداشته باشد، از Fallback استفاده می‌شود
    private IEnumerable<string> GetTools(Finding finding)
        => finding.FixTools.Count > 0 ? finding.FixTools : new[] { GetFixMethod(finding.CheckId) };

    // EDIT: رنگ بج Risk بر اساس امتیاز واقعی
    private static string GetRiskClass(int score)
        => score >= 80 ? "risk-high" : score >= 50 ? "risk-mid" : "risk-low";

    private void SetFilterAll() => SelectedFilter = "All";
    private void SetFilterPass() => SelectedFilter = "Pass";
    private void SetFilterFail() => SelectedFilter = "Fail";
    private void SetFilterWarn() => SelectedFilter = "Warning";

    private void SetCategory(string? category) => SelectedCategory = category;

    private void OpenDrawer(Finding finding) => SelectedFinding = finding;
    private void CloseDrawer() => SelectedFinding = null;

    // ── ب: اکشن‌های هر ردیف، متصل به منطق واقعی ──
    private void LaunchTool(string tool) => StateService.LaunchFixTool(tool);

    private void UndoFinding(Finding finding)
    {
        finding.Undo();
        StateService.LogAction($"User undid ignore: {finding.CheckId}");
        StateHasChanged();
    }

    // EDIT: lambdaasync — چون EventCallback دکمه‌ها Task را پشتیبانی می‌کند
    private async Task RescanFinding(Finding finding)
    {
        await StateService.RescanSingleCheckAsync(finding.CheckId);
    }

    private void IgnoreFindingRow(Finding finding)
    {
        finding.Ignore();
        StateService.LogAction($"User ignored finding: {finding.CheckId}");
        StateHasChanged();
    }

    private void IgnoreFinding()
    {
        if (SelectedFinding != null)
        {
            SelectedFinding.Ignore();
            StateService.LogAction($"User ignored finding: {SelectedFinding.CheckId}");
            StateHasChanged();
        }
    }
}