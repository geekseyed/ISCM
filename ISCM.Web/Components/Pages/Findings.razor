@page "/findings"
@rendermode InteractiveServer
@using ISCM.Domain.Entities
@using ISCM.Domain.Enums
@using ISCM.Web.Services
@inject ScanStateService StateService

<PageTitle>DefenDoor - Findings</PageTitle>

<style>
    .glass-panel {
        background: rgba(30, 41, 59, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-sizing: border-box;
    }

    .header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
        flex-shrink: 0;
    }

    .btn-back {
        background: #334155;
        border: none;
        padding: 8px 20px;
        color: #06b6d4;
        font-weight: bold;
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
    }

    .filter-btn {
        background: #334155;
        border: none;
        padding: 8px 20px;
        color: #e2e8f0;
        border-radius: 6px;
        cursor: pointer;
        font-weight: bold;
        transition: 0.2s;
    }

        .filter-btn.active {
            background: #06b6d4;
            color: white;
        }

    .search-box {
        background: #0f172a;
        border: 1px solid #334155;
        padding: 8px 15px;
        border-radius: 6px;
        color: white;
        width: 250px;
    }

    .table-container {
        flex-grow: 1;
        overflow-y: auto;
        border: 1px solid #1e293b;
        border-radius: 8px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        text-align: left;
        padding: 10px;
        background: #0f172a;
        color: #06b6d4;
        border-bottom: 2px solid #334155;
        position: sticky;
        top: 0;
        z-index: 1;
        font-size: 13px;
    }

    td {
        padding: 10px;
        border-bottom: 1px solid #334155;
        font-size: 13px;
    }

    tr {
        cursor: pointer;
        transition: 0.2s;
    }

        tr:hover {
            background-color: rgba(6, 182, 212, 0.05);
        }

    .status-pass {
        color: #10b981;
        font-weight: bold;
        background: rgba(16, 185, 129, 0.1);
        padding: 4px 8px;
        border-radius: 4px;
    }

    .status-fail {
        color: #ef4444;
        font-weight: bold;
        background: rgba(239, 68, 68, 0.1);
        padding: 4px 8px;
        border-radius: 4px;
    }

    .status-warning {
        color: #f59e0b;
        font-weight: bold;
        background: rgba(245, 158, 11, 0.1);
        padding: 4px 8px;
        border-radius: 4px;
    }

    .status-ignored {
        color: #94a3b8;
        font-weight: bold;
        background: rgba(148, 163, 184, 0.1);
        padding: 4px 8px;
        border-radius: 4px;
    }

    .sev-high {
        color: #ef4444;
        font-weight: bold;
    }

    .sev-critical {
        color: #dc2626;
        font-weight: bold;
    }

    .sev-medium {
        color: #f59e0b;
    }

    .sev-low {
        color: #94a3b8;
    }

    .fix-method {
        color: #06b6d4;
        font-family: monospace;
        font-size: 11px;
        cursor: pointer;
        text-decoration: underline;
    }

    .drawer-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 1000;
        display: none;
    }

        .drawer-overlay.active {
            display: block;
        }

    .drawer {
        position: fixed;
        top: 0;
        right: 0;
        width: 450px;
        height: 100%;
        background: #1e293b;
        box-shadow: -5px 0 15px rgba(0,0,0,0.5);
        z-index: 1001;
        transform: translateX(100%);
        transition: transform 0.3s ease-in-out;
        padding: 30px;
        overflow-y: auto;
        border-left: 2px solid #06b6d4;
    }

        .drawer.open {
            transform: translateX(0);
        }

    .drawer-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #334155;
        padding-bottom: 15px;
        margin-bottom: 20px;
    }

    .drawer-title {
        color: #06b6d4;
        font-size: 20px;
        font-weight: bold;
    }

    .btn-close {
        background: #ef4444;
        color: white;
        border: none;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        cursor: pointer;
        font-weight: bold;
    }

    .detail-section {
        margin-bottom: 20px;
    }

    .detail-label {
        color: #64748b;
        font-size: 12px;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .detail-value {
        color: #e2e8f0;
        font-size: 14px;
        line-height: 1.5;
    }

    .btn-ignore {
        background: #f59e0b;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: bold;
        width: 100%;
        margin-top: 20px;
    }

        .btn-ignore:disabled {
            background: #475569;
            cursor: not-allowed;
        }
</style>

<div class="glass-panel">
    <div class="header-row">
        <h2 style="color:#e2e8f0;">Security Findings Details</h2>
        <a href="/" class="btn-back">⬅️ Back to Dashboard</a>
    </div>

    @if (StateService.CurrentScanResult == null)
    {
        <p style="color:#94a3b8; text-align:center; padding:40px;">No scan data available. Please go to <a href="/" style="color:#06b6d4;">Dashboard</a> and run a scan first.</p>
    }
    else
    {
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-shrink: 0;">
            <div style="display: flex; gap: 10px;">
                <button class="filter-btn @(SelectedFilter == "All" ? "active" : "")" @onclick="SetFilterAll">All</button>
                <button class="filter-btn @(SelectedFilter == "Pass" ? "active" : "")" @onclick="SetFilterPass">Pass</button>
                <button class="filter-btn @(SelectedFilter == "Fail" ? "active" : "")" @onclick="SetFilterFail">Fail</button>
            </div>
            <input type="text" class="search-box" placeholder="Search..." @bind="SearchTerm" @bind:event="oninput" />
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Severity</th>
                        <th>Fix Method</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var finding in FilteredFindings)
                    {
                        <tr @onclick="() => OpenDrawer(finding)">
                            <td style="color: #64748b; font-family: monospace;">@finding.CheckId</td>
                            <td>@finding.Name</td>
                            <td><span class="sev-@finding.Severity.ToString().ToLower()">@finding.Severity</span></td>
                            <td><span class="fix-method">@GetFixMethod(finding.CheckId)</span></td>
                            <td><span class="status-@finding.Status.ToString().ToLower()">@finding.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (SelectedFinding != null)
{
    <div class="drawer-overlay active" @onclick="CloseDrawer"></div>
    <div class="drawer open">
        <div class="drawer-header">
            <div class="drawer-title">@SelectedFinding.Name</div>
            <button class="btn-close" @onclick="CloseDrawer">X</button>
        </div>
        <div class="detail-section"><div class="detail-label">Check ID</div><div class="detail-value" style="font-family: monospace; color: #06b6d4;">@SelectedFinding.CheckId</div></div>
        <div class="detail-section"><div class="detail-label">Status & Severity</div><div style="display: flex; gap: 10px; margin-top: 5px;"><span class="status-@SelectedFinding.Status.ToString().ToLower()">@SelectedFinding.Status</span><span style="color: #f59e0b; font-weight: bold;">@SelectedFinding.Severity</span></div></div>
        <div class="detail-section"><div class="detail-label">Expected Value</div><div class="detail-value">@SelectedFinding.ExpectedValue</div></div>
        <div class="detail-section"><div class="detail-label">Current Value</div><div class="detail-value" style="color: #ef4444;">@SelectedFinding.CurrentValue</div></div>
        <div class="detail-section"><div class="detail-label">Recommendation</div><div class="detail-value">@SelectedFinding.Recommendation</div></div>

        @if (SelectedFinding.Status != CheckStatus.Ignored)
        {
            <button class="btn-ignore" @onclick="IgnoreFinding">🚫 Ignore This Finding</button>
        }
        else
        {
            <button class="btn-ignore" disabled>✓ Ignored</button>
        }
    </div>
}

@code {
    private string SelectedFilter = "All";
    private string SearchTerm = "";
    private Finding? SelectedFinding;

    [SupplyParameterFromQuery(Name = "category")]
    public string? SelectedCategory { get; set; }

    private IEnumerable<Finding> FilteredFindings
    {
        get
        {
            if (StateService.CurrentScanResult == null) return new List<Finding>();
            var findings = StateService.CurrentScanResult.Findings.AsEnumerable();
            if (!string.IsNullOrEmpty(SelectedCategory)) findings = findings.Where(f => f.Category.ToString() == SelectedCategory);
            if (SelectedFilter != "All") findings = findings.Where(f => f.Status.ToString() == SelectedFilter);
            if (!string.IsNullOrWhiteSpace(SearchTerm)) findings = findings.Where(f => f.Name.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) || f.CheckId.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase));
            return findings;
        }
    }

    // استخراج ابزار رفع مشکل از روی آیدی چک
    private string GetFixMethod(string checkId)
    {
        if (checkId.StartsWith("FW") || checkId.StartsWith("SMB")) return "powershell.exe";
        if (checkId.StartsWith("GUEST") || checkId.StartsWith("ADM")) return "net.exe";
        if (checkId.StartsWith("PWD") || checkId.StartsWith("AUD")) return "secpol.msc";
        return "regedit.exe";
    }

    private void SetFilterAll() => SelectedFilter = "All";
    private void SetFilterPass() => SelectedFilter = "Pass";
    private void SetFilterFail() => SelectedFilter = "Fail";

    private void OpenDrawer(Finding finding) => SelectedFinding = finding;
    private void CloseDrawer() => SelectedFinding = null;

    private void IgnoreFinding()
    {
        if (SelectedFinding != null)
        {
            SelectedFinding.Ignore(); // فراخوانی متد از لایه Domain
            StateService.LogAction($"User ignored finding: {SelectedFinding.CheckId}");
            StateHasChanged();
        }
    }
}