@page "/reports"
@rendermode InteractiveServer
@using ISCM.Application.Interfaces
@using ISCM.Domain.Entities
@using ISCM.Web.Services
@inject ScanStateService StateService
@inject IBaselineService BaselineService

<PageTitle>DefenDoor - Reports</PageTitle>

<style>
    .glass-panel {
        background: rgba(30, 41, 59, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        margin-bottom: 16px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .page-title {
        font-size: 24px;
        font-weight: 700;
        color: #e2e8f0;
        margin: 0;
    }

    .btn-back {
        background: #334155;
        border: none;
        padding: 10px 20px;
        color: #06b6d4;
        font-weight: bold;
        border-radius: 8px;
        cursor: pointer;
        text-decoration: none;
        font-size: 13px;
        transition: 0.2s;
    }

    .btn-back:hover {
        background: #475569;
        transform: translateY(-2px);
    }

    .report-section {
        margin-bottom: 24px;
    }

    .section-title {
        font-size: 16px;
        font-weight: 600;
        color: #94a3b8;
        margin-bottom: 16px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .target-input-group {
        margin-bottom: 20px;
    }

    .target-label {
        display: block;
        color: #94a3b8;
        font-size: 13px;
        margin-bottom: 8px;
        font-weight: 500;
    }

    .target-input {
        width: 100%;
        background: #0f172a;
        border: 1px solid #334155;
        color: #e2e8f0;
        font-size: 14px;
        padding: 12px 16px;
        border-radius: 8px;
        transition: 0.2s;
    }

    .target-input:focus {
        outline: none;
        border-color: #06b6d4;
        box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.1);
    }

    .report-types {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .report-type-card {
        background: rgba(15, 23, 42, 0.6);
        border: 2px solid #334155;
        border-radius: 12px;
        padding: 20px;
        cursor: pointer;
        transition: 0.3s;
        text-align: center;
    }

    .report-type-card:hover {
        border-color: #06b6d4;
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(6, 182, 212, 0.2);
    }

    .report-type-card.active {
        border-color: #06b6d4;
        background: rgba(6, 182, 212, 0.1);
        box-shadow: 0 0 20px rgba(6, 182, 212, 0.3);
    }

    .report-type-icon {
        font-size: 32px;
        margin-bottom: 12px;
    }

    .report-type-name {
        font-size: 15px;
        font-weight: 600;
        color: #e2e8f0;
        margin-bottom: 6px;
    }

    .report-type-desc {
        font-size: 12px;
        color: #64748b;
    }

    .baseline-selector {
        margin-bottom: 20px;
    }

    .baseline-select {
        width: 100%;
        background: #0f172a;
        border: 1px solid #334155;
        color: #e2e8f0;
        font-size: 14px;
        padding: 12px 16px;
        border-radius: 8px;
        cursor: pointer;
    }

    .baseline-select:focus {
        outline: none;
        border-color: #06b6d4;
    }

    .btn-generate {
        background: linear-gradient(45deg, #06b6d4, #3b82f6);
        border: none;
        padding: 14px 32px;
        color: white;
        font-size: 15px;
        font-weight: bold;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.3s;
        box-shadow: 0 4px 16px rgba(6, 182, 212, 0.3);
        width: 100%;
    }

    .btn-generate:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(6, 182, 212, 0.4);
    }

    .btn-generate:disabled {
        background: #475569;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    .report-preview {
        background: rgba(15, 23, 42, 0.8);
        border: 1px solid #334155;
        border-radius: 12px;
        padding: 20px;
        margin-top: 24px;
        font-family: 'Consolas', monospace;
        font-size: 12px;
        max-height: 500px;
        overflow-y: auto;
    }

    .report-header {
        border-bottom: 2px solid #06b6d4;
        padding-bottom: 16px;
        margin-bottom: 16px;
    }

    .report-title {
        font-size: 20px;
        font-weight: bold;
        color: #06b6d4;
        margin-bottom: 8px;
    }

    .report-meta {
        color: #94a3b8;
        font-size: 11px;
        line-height: 1.8;
    }

    .report-summary {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin: 20px 0;
    }

    .summary-box {
        background: rgba(30, 41, 59, 0.6);
        border-radius: 8px;
        padding: 16px;
        text-align: center;
    }

    .summary-value {
        font-size: 28px;
        font-weight: 800;
        margin-bottom: 4px;
    }

    .summary-value.pass { color: #10b981; }
    .summary-value.fail { color: #ef4444; }
    .summary-value.warning { color: #f59e0b; }
    .summary-value.total { color: #06b6d4; }

    .summary-label {
        font-size: 11px;
        color: #64748b;
        text-transform: uppercase;
    }

    .findings-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 16px;
    }

    .findings-table th {
        background: rgba(30, 41, 59, 0.8);
        color: #94a3b8;
        font-size: 11px;
        text-transform: uppercase;
        padding: 12px;
        text-align: left;
        border-bottom: 2px solid #334155;
    }

    .findings-table td {
        padding: 12px;
        border-bottom: 1px solid #1e293b;
        font-size: 12px;
        color: #e2e8f0;
    }

    .findings-table tr:hover {
        background: rgba(6, 182, 212, 0.05);
    }

    .status-badge {
        padding: 4px 12px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: bold;
        text-transform: uppercase;
    }

    .status-badge.pass {
        background: rgba(16, 185, 129, 0.2);
        color: #10b981;
    }

    .status-badge.fail {
        background: rgba(239, 68, 68, 0.2);
        color: #ef4444;
    }

    .status-badge.warning {
        background: rgba(245, 158, 11, 0.2);
        color: #f59e0b;
    }
</style>

<div class="glass-panel">
    <div class="page-header">
        <h1 class="page-title">📊 Reports & Export Center</h1>
        <a href="/" class="btn-back">← Back to Dashboard</a>
    </div>

    <div class="report-section">
        <div class="section-title">Report Configuration</div>
        
        <!-- Target Name Input -->
        <div class="target-input-group">
            <label class="target-label">📍 Target System Name (نام سیستم هدف)</label>
            <input type="text" 
                   class="target-input" 
                   @bind="TargetName" 
                   @bind:event="oninput"
                   placeholder="e.g., Mining Center Server 01 / سرور اصلی معدنچی" />
        </div>

        <!-- Baseline Selection -->
        <div class="baseline-selector">
            <label class="target-label"> Compliance Baseline (استاندارد انطباق)</label>
            <select class="baseline-select" @bind="SelectedBaselineId">
                @foreach (var baseline in AvailableBaselines)
                {
                    <option value="@baseline.BaselineId">
                        @baseline.Name (v@baseline.Version)
                    </option>
                }
            </select>
        </div>
    </div>

    <div class="report-section">
        <div class="section-title">Report Type</div>
        <div class="report-types">
            <div class="report-type-card @(ReportType == "Current" ? "active" : "")" 
                 @onclick="() => ReportType = 'Current'">
                <div class="report-type-icon">📄</div>
                <div class="report-type-name">Current State</div>
                <div class="report-type-desc">وضعیت فعلی سیستم بر اساس Baseline انتخابی</div>
            </div>

            <div class="report-type-card @(ReportType == "BeforeAfter" ? "active" : "")" 
                 @onclick="() => ReportType = 'BeforeAfter'">
                <div class="report-type-icon"></div>
                <div class="report-type-name">Before/After</div>
                <div class="report-type-desc">مقایسه وضعیت قبل و بعد از Hardening</div>
            </div>

            <div class="report-type-card @(ReportType == "Remediation" ? "active" : "")" 
                 @onclick="() => ReportType = 'Remediation'">
                <div class="report-type-icon">🔧</div>
                <div class="report-type-name">Remediation</div>
                <div class="report-type-desc">گزارش اقدامات اصلاحی انجام شده</div>
            </div>
        </div>
    </div>

    <button class="btn-generate" @onclick="GenerateReport" disabled="@(StateService.CurrentScanResult == null)">
        📥 Generate Report
    </button>

    @if (ReportGenerated)
    {
        <div class="report-preview">
            <div class="report-header">
                <div class="report-title">DefenDoor Security Compliance Report</div>
                <div class="report-meta">
                    <strong>Target:</strong> @TargetName<br/>
                    <strong>Baseline:</strong> @SelectedBaselineName<br/>
                    <strong>Generated:</strong> @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")<br/>
                    <strong>Hostname:</strong> @StateService.DisplayHostname<br/>
                    <strong>IP Address:</strong> @StateService.DisplayIpAddress<br/>
                    <strong>OS:</strong> @StateService.DisplayOsVersion
                </div>
            </div>

            <div class="report-summary">
                <div class="summary-box">
                    <div class="summary-value total">@StateService.CurrentScanResult?.Findings.Count</div>
                    <div class="summary-label">Total Checks</div>
                </div>
                <div class="summary-box">
                    <div class="summary-value pass">@StateService.CurrentScanResult?.PassCount</div>
                    <div class="summary-label">Passed</div>
                </div>
                <div class="summary-box">
                    <div class="summary-value fail">@StateService.CurrentScanResult?.FailCount</div>
                    <div class="summary-label">Failed</div>
                </div>
                <div class="summary-box">
                    <div class="summary-value warning">@StateService.CurrentScanResult?.WarningCount</div>
                    <div class="summary-label">Warnings</div>
                </div>
            </div>

            <h3 style="color: #94a3b8; font-size: 14px; margin: 20px 0 12px 0;">Detailed Findings</h3>
            <table class="findings-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Control Name</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Severity</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var finding in StateService.CurrentScanResult?.Findings ?? new List<Finding>())
                    {
                        <tr>
                            <td>@finding.CheckId</td>
                            <td>@finding.Name</td>
                            <td>@finding.Category</td>
                            <td>
                                <span class="status-badge @finding.Status.ToString().ToLower()">
                                    @finding.Status
                                </span>
                            </td>
                            <td>@finding.Severity</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div style="margin-top: 24px; padding-top: 16px; border-top: 1px solid #334155; color: #64748b; font-size: 11px;">
                <strong>Compliance Score:</strong> @StateService.CurrentScanResult?.ComplianceScore% | 
                <strong>Grade:</strong> @StateService.CurrentScanResult?.Grade
            </div>
        </div>
    }
</div>

@code {
    private string TargetName { get; set; } = "";
    private string ReportType { get; set; } = "Current";
    private string SelectedBaselineId { get; set; } = "HOSSEINI-V1";
    private string SelectedBaselineName { get; set; } = "Hosseini Windows 11 Hardening Standard";
    private List<BaselineDefinition> AvailableBaselines { get; set; } = new();
    private bool ReportGenerated { get; set; } = false;

    protected override void OnInitialized()
    {
        AvailableBaselines = BaselineService.GetAllBaselines();
        
        // Set default baseline name
        var defaultBaseline = BaselineService.GetBaselineById(SelectedBaselineId);
        if (defaultBaseline != null)
        {
            SelectedBaselineName = defaultBaseline.Name;
        }
    }

    private void OnBaselineChanged(ChangeEventArgs e)
    {
        SelectedBaselineId = e.Value?.ToString() ?? "HOSSEINI-V1";
        var baseline = BaselineService.GetBaselineById(SelectedBaselineId);
        if (baseline != null)
        {
            SelectedBaselineName = baseline.Name;
        }
    }

    private void GenerateReport()
    {
        // Update ScanStateService with target name
        StateService.SetReportTargetName(TargetName);
        
        ReportGenerated = true;
        StateHasChanged();
    }
}