@page "/"
@rendermode InteractiveServer
@using ISCM.Application.Interfaces
@using ISCM.Domain.Entities
@using ISCM.Domain.Enums
@using ISCM.Web.Services
@inject IScanService ScanService
@inject ScanStateService StateService
@inject ScanHistoryService HistoryService

<PageTitle>DefenDoor - Dashboard</PageTitle>

<style>
    .glass-panel {
        background: rgba(30, 41, 59, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        margin-bottom: 20px;
    }

    .btn-scan {
        background: linear-gradient(45deg, #06b6d4, #3b82f6);
        border: none;
        padding: 12px 30px;
        color: white;
        font-size: 16px;
        font-weight: bold;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.3s;
        box-shadow: 0 0 15px rgba(6, 182, 212, 0.4);
    }

        .btn-scan:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 25px rgba(6, 182, 212, 0.6);
        }

        .btn-scan:disabled {
            background: #475569;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
        }

    .btn-nav {
        background: #334155;
        border: none;
        padding: 12px 30px;
        color: #06b6d4;
        font-size: 16px;
        font-weight: bold;
        border-radius: 8px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        margin-left: 15px;
    }

    .context-selector {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .selector-group {
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(15, 23, 42, 0.6);
        padding: 10px 20px;
        border-radius: 10px;
    }

    .selector-label {
        color: #64748b;
        font-size: 12px;
        text-transform: uppercase;
    }

    .selector-btn {
        background: #334155;
        border: none;
        padding: 6px 16px;
        color: #94a3b8;
        border-radius: 6px;
        cursor: pointer;
        font-weight: bold;
        transition: 0.2s;
    }

        .selector-btn.active {
            background: #06b6d4;
            color: white;
        }

    .console-box {
        background: #000000;
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 10px;
        height: 100px;
        overflow-y: auto;
        margin-top: 15px;
        font-family: 'Consolas', monospace;
        font-size: 12px;
        text-align: left;
    }

    .console-line {
        color: #10b981;
        margin-bottom: 3px;
    }

    .console-time {
        color: #64748b;
        margin-right: 10px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
        margin-bottom: 20px;
    }

    .info-card {
        background: rgba(15, 23, 42, 0.6);
        padding: 15px;
        border-radius: 10px;
        border-left: 4px solid #06b6d4;
    }

    .info-label {
        color: #64748b;
        font-size: 11px;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .info-value {
        color: #e2e8f0;
        font-weight: bold;
        font-family: monospace;
        font-size: 14px;
    }

    .score-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: rgba(15, 23, 42, 0.8);
        padding: 20px;
        border-radius: 10px;
        border: 1px solid #334155;
        margin-bottom: 20px;
    }

    .score-number {
        font-size: 42px;
        font-weight: 800;
    }

    .score-grade {
        font-size: 20px;
        color: #06b6d4;
        margin-left: 15px;
        background: rgba(6, 182, 212, 0.1);
        padding: 5px 15px;
        border-radius: 20px;
    }

    .category-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
    }

    .category-card {
        background: rgba(15, 23, 42, 0.8);
        padding: 15px;
        border-radius: 10px;
        border-top: 4px solid #06b6d4;
        text-align: center;
        transition: 0.3s;
        text-decoration: none;
        color: #e2e8f0;
        display: block;
    }

        .category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.3);
            background: rgba(6, 182, 212, 0.1);
        }

        .category-card.fail {
            border-top-color: #ef4444;
        }

        .category-card.pass {
            border-top-color: #10b981;
        }

    .category-title {
        color: #94a3b8;
        font-size: 13px;
        margin-bottom: 10px;
        text-transform: uppercase;
        font-weight: bold;
    }

    .category-stats {
        display: flex;
        justify-content: center;
        gap: 15px;
        font-size: 13px;
    }

    .stat-pass {
        color: #10b981;
        font-weight: bold;
    }

    .stat-fail {
        color: #ef4444;
        font-weight: bold;
    }

    .loading-spinner {
        border: 3px solid #334155;
        border-top: 3px solid #06b6d4;
        border-radius: 50%;
        width: 16px;
        height: 16px;
        animation: spin 1s linear infinite;
        display: inline-block;
        vertical-align: middle;
        margin-left: 10px;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }
</style>

<div class="glass-panel">
    <div class="context-selector">
        <div class="selector-group">
            <span class="selector-label">Zone:</span>
            @foreach (var z in new[] { "MRDC", "AOC", "ERDC", "SRDC", "NRDC" })
            {
                <button class="selector-btn @(StateService.SelectedZone == z ? "active" : "")" @onclick="() => StateService.SelectedZone = z">@z</button>
            }
        </div>
        <div class="selector-group">
            <span class="selector-label">System:</span>
            @foreach (var s in new[] { "سیستم مسئول شیفت", "سیستم کارشناس شیفت" })
            {
                <button class="selector-btn @(StateService.SelectedSystem == s ? "active" : "")" @onclick="() => StateService.SelectedSystem = s">@s</button>
            }
        </div>
    </div>

    <div style="text-align: center; margin-bottom: 20px;">
        <button class="btn-scan" @onclick="StartScanAsync" disabled="@StateService.IsScanning">
            @if (StateService.IsScanning)
            {
                <span>Scanning System...</span> <div class="loading-spinner"></div>
            }
            else
            {
                <span>⚡ Start Real Scan</span>
            }
        </button>
        @if (StateService.CurrentScanResult != null && !StateService.IsScanning)
        {
            <a href="/findings" class="btn-nav">Go to Findings ➡️</a>
        }
    </div>

    @if (_consoleLogs.Any())
    {
        <div class="console-box">
            @foreach (var log in _consoleLogs)
            {
                <div class="console-line">
                    <span class="console-time">[@log.Time.ToString("HH:mm:ss")]</span>
                    <span>@log.Message</span>
                </div>
            }
        </div>
    }
</div>

@if (!StateService.IsScanning && StateService.CurrentScanResult != null)
{
    var result = StateService.CurrentScanResult;
    <div class="glass-panel">
        <div style="text-align: center; margin-bottom: 20px; color: #06b6d4; font-family: monospace; font-size: 14px;">
            Hostname Context: @StateService.HostnameContext
        </div>

        <div class="info-grid">
            <div class="info-card"><div class="info-label">Hostname</div><div class="info-value">@result.Hostname</div></div>
            <div class="info-card"><div class="info-label">IP Address</div><div class="info-value">@result.IpAddress</div></div>
            <div class="info-card"><div class="info-label">OS Edition</div><div class="info-value" style="font-size: 13px;">@result.OsVersion</div></div>
            <div class="info-card"><div class="info-label">OS Build</div><div class="info-value" style="font-size: 13px;">@result.OsBuild</div></div>
        </div>

        <div class="score-container">
            <div>
                <span style="color: #64748b; font-size: 12px;">COMPLIANCE SCORE</span><br />
                <span class="score-number" style="color: @(result.ComplianceScore > 70 ? "#10b981" : "#ef4444");">@result.ComplianceScore%</span>
                <span class="score-grade">Grade @result.Grade</span>
            </div>
            <div style="text-align: right;">
                <div style="display: flex; gap: 20px; font-size: 16px;">
                    <div><span class="stat-pass">@result.PassCount</span> <span style="color:#64748b; font-size:11px;">PASS</span></div>
                    <div><span class="stat-fail">@result.FailCount</span> <span style="color:#64748b; font-size:11px;">FAIL</span></div>
                    <div><span style="color: #f59e0b; font-weight: bold;">@result.WarningCount</span> <span style="color:#64748b; font-size:11px;">WARN</span></div>
                </div>
            </div>
        </div>

        <h3 style="color: #94a3b8; margin-bottom: 15px; font-size: 13px; text-transform: uppercase; letter-spacing: 1px;">Category Breakdown</h3>
        <div class="category-grid">
            @foreach (var group in CategoryBreakdown)
            {
                var hasFail = group.FailCount > 0;
                <a href="@($"/findings?category={group.Category}")" class="category-card @(hasFail ? "fail" : "pass")">
                    <div class="category-title">@group.Category</div>
                    <div class="category-stats">
                        <span class="stat-pass">@group.PassCount Pass</span>
                        <span class="stat-fail">@group.FailCount Fail</span>
                    </div>
                </a>
            }
        </div>
    </div>
}

@code {
    private string? _errorMessage;
    public class ConsoleLogEntry { public DateTime Time { get; set; } public string Message { get; set; } = ""; }
    private List<ConsoleLogEntry> _consoleLogs = new();
    public class CategoryStat { public string Category { get; set; } = ""; public int PassCount { get; set; } public int FailCount { get; set; } }
    private List<CategoryStat> CategoryBreakdown { get; set; } = new();

    protected override void OnInitialized() => CalculateCategoryBreakdown();

    private async Task StartScanAsync()
    {
        if (StateService.IsScanning) return;
        try
        {
            StateService.IsScanning = true;
            _errorMessage = null; _consoleLogs.Clear(); StateHasChanged();
            StateService.LogAction($"Scan started for {StateService.HostnameContext}");

            var progress = new Progress<string>(status =>
            {
                _consoleLogs.Add(new ConsoleLogEntry { Time = DateTime.Now, Message = status });
                StateHasChanged();
            });

            var scanResult = await ScanService.RunScanAsync(ScanMode.Full, progress);
            StateService.CurrentScanResult = scanResult;
            HistoryService.AddScan(scanResult);
            StateService.LogAction($"Scan completed. Score: {scanResult.ComplianceScore}%");
            CalculateCategoryBreakdown();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            StateService.IsScanning = false;
        }
    }

    private void CalculateCategoryBreakdown()
    {
        CategoryBreakdown.Clear();
        if (StateService.CurrentScanResult == null) return;
        CategoryBreakdown = Enum.GetValues(typeof(CheckCategory)).Cast<CheckCategory>().Select(c => new CategoryStat
            {
                Category = c.ToString(),
                PassCount = StateService.CurrentScanResult.Findings.Count(f => f.Category == c && f.Status == CheckStatus.Pass),
                FailCount = StateService.CurrentScanResult.Findings.Count(f => f.Category == c && f.Status == CheckStatus.Fail)
            }).ToList();
    }
}