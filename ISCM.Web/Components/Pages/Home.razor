@page "/"
@rendermode InteractiveServer
@using ISCM.Application.Interfaces
@using ISCM.Domain.Entities
@using ISCM.Domain.Enums
@using ISCM.Web.Services
@inject ScanStateService StateService
@implements IDisposable

<PageTitle>DefenDoor - Dashboard</PageTitle>

<style>
    .glass-panel {
        background: rgba(30, 41, 59, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 12px;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        margin-bottom: 10px;
    }

    .btn-scan {
        background: linear-gradient(45deg, #06b6d4, #3b82f6);
        border: none;
        padding: 10px 25px;
        color: white;
        font-size: 15px;
        font-weight: bold;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.3s;
        box-shadow: 0 0 15px rgba(6, 182, 212, 0.4);
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-scan:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 25px rgba(6, 182, 212, 0.6);
        }

        .btn-scan:disabled {
            background: #475569;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
        }

    .btn-nav {
        background: #334155;
        border: none;
        padding: 10px 25px;
        color: #06b6d4;
        font-size: 15px;
        font-weight: bold;
        border-radius: 8px;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        margin-left: 10px;
    }

    .scan-console {
        background: #0a0e1a;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 8px;
        margin-top: 10px;
        overflow: hidden;
    }

    .console-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 6px 14px;
        background: #1a2033;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        font-size: 12px;
        color: #94a3b8;
    }

    .console-status {
        display: flex;
        align-items: center;
        gap: 6px;
        font-family: 'Consolas', monospace;
        font-size: 11px;
    }

        .console-status .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #64748b;
        }

        .console-status.scanning .dot {
            background: #f59e0b;
            animation: pulse 1s infinite;
        }

        .console-status.complete .dot {
            background: #10b981;
        }

        .console-status.failed .dot {
            background: #ef4444;
        }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.3;
        }
    }

    .console-body {
        height: 70px;
        overflow-y: auto;
        padding: 6px 14px;
        font-family: 'Consolas', monospace;
        font-size: 12px;
        line-height: 1.4;
        color: #10b981;
    }

    .console-summary {
        display: flex;
        border-top: 1px solid rgba(255,255,255,0.1);
        background: #1a2033;
    }

    .summary-item {
        flex: 1;
        padding: 6px 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        border-right: 1px solid rgba(255,255,255,0.06);
    }

        .summary-item:last-child {
            border-right: none;
        }

    .summary-num {
        font-size: 14px;
        font-weight: 700;
        font-family: 'Consolas', monospace;
        color: #e2e8f0;
    }

        .summary-num.pass {
            color: #10b981;
        }

        .summary-num.fail {
            color: #ef4444;
        }

        .summary-num.warn {
            color: #f59e0b;
        }

    .summary-label {
        font-size: 9px;
        color: #64748b;
        text-transform: uppercase;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin: 10px 0;
    }

    .info-card {
        background: rgba(15, 23, 42, 0.6);
        padding: 10px;
        border-radius: 8px;
        border-left: 3px solid #06b6d4;
    }

    .info-label {
        color: #64748b;
        font-size: 10px;
        margin-bottom: 3px;
        text-transform: uppercase;
    }

    .info-value {
        color: #e2e8f0;
        font-weight: bold;
        font-family: monospace;
        font-size: 13px;
    }

    .date-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 10px;
    }

    .date-card {
        background: rgba(15, 23, 42, 0.6);
        padding: 10px;
        border-radius: 8px;
        border-left: 3px solid #f59e0b;
    }

    .date-input {
        background: #0f172a;
        border: 1px solid #334155;
        padding: 4px 8px;
        border-radius: 4px;
        color: white;
        width: 100%;
        font-family: monospace;
        font-size: 13px;
    }

    .score-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: rgba(15, 23, 42, 0.8);
        padding: 12px;
        border-radius: 8px;
        border: 1px solid #334155;
        margin-bottom: 10px;
    }

    .score-display {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .score-ring {
        position: relative;
        width: 90px;
        height: 90px;
        flex-shrink: 0;
    }

        .score-ring svg {
            width: 100%;
            height: 100%;
            transform: rotate(-90deg);
        }

        .score-ring circle {
            fill: none;
            stroke-width: 8;
        }

    .ring-bg {
        stroke: rgba(255, 255, 255, 0.1);
    }

    .ring-fill {
        stroke-linecap: round;
        transition: stroke-dashoffset 0.5s ease;
    }

    .score-value {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
    }

    .score-percent {
        font-size: 22px;
        font-weight: 800;
        line-height: 1;
    }

    .score-grade-text {
        font-size: 11px;
        color: #94a3b8;
        margin-top: 2px;
    }

    .score-stats {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .stat-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: #94a3b8;
    }

    .stat-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

        .stat-dot.pass {
            background: #10b981;
        }

        .stat-dot.fail {
            background: #ef4444;
        }

        .stat-dot.warn {
            background: #f59e0b;
        }

    .stat-num {
        font-size: 16px;
        font-weight: 700;
        font-family: 'Consolas', monospace;
        margin-left: auto;
    }

        .stat-num.pass {
            color: #10b981;
        }

        .stat-num.fail {
            color: #ef4444;
        }

        .stat-num.warn {
            color: #f59e0b;
        }

    .donut-section {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-top: 10px;
        padding-top: 10px;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .donut-chart {
        position: relative;
        width: 70px;
        height: 70px;
        flex-shrink: 0;
    }

        .donut-chart svg {
            width: 100%;
            height: 100%;
            transform: rotate(-90deg);
        }

    .donut-center {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
    }

    .donut-num {
        font-size: 14px;
        font-weight: 700;
        color: #e2e8f0;
    }

    .donut-label {
        font-size: 8px;
        color: #64748b;
        text-transform: uppercase;
    }

    .donut-legend {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11px;
        color: #94a3b8;
    }

    .legend-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

        .legend-dot.pass {
            background: #10b981;
        }

        .legend-dot.fail {
            background: #ef4444;
        }

        .legend-dot.warn {
            background: #f59e0b;
        }

    .legend-num {
        font-weight: bold;
        font-family: 'Consolas', monospace;
        margin-left: auto;
        color: #e2e8f0;
    }

    .category-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
    }

    .category-card {
        background: rgba(15, 23, 42, 0.8);
        padding: 10px;
        border-radius: 8px;
        border-top: 3px solid #06b6d4;
        text-align: center;
        transition: 0.3s;
        text-decoration: none;
        color: #e2e8f0;
        display: block;
    }

        .category-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
            background: rgba(6, 182, 212, 0.1);
        }

        .category-card.fail {
            border-top-color: #ef4444;
        }

        .category-card.pass {
            border-top-color: #10b981;
        }

    .category-title {
        color: #94a3b8;
        font-size: 11px;
        margin-bottom: 5px;
        text-transform: uppercase;
        font-weight: bold;
    }

    .category-stats {
        display: flex;
        justify-content: center;
        gap: 10px;
        font-size: 12px;
    }

    .stat-pass {
        color: #10b981;
        font-weight: bold;
    }

    .stat-fail {
        color: #ef4444;
        font-weight: bold;
    }

    .loading-spinner {
        border: 3px solid rgba(255,255,255,0.3);
        border-top: 3px solid #fff;
        border-radius: 50%;
        width: 14px;
        height: 14px;
        animation: spin 1s linear infinite;
        display: inline-block;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }
</style>

<div class="glass-panel">
    <div style="text-align: center; margin-bottom: 10px;">
        <button class="btn-scan" @onclick="StateService.ExecuteScanAsync" disabled="@StateService.IsScanning">
            @if (StateService.IsScanning)
            {
                <span>Scanning System...</span> <div class="loading-spinner"></div>
            }
            else
            {
                <span>⚡ Start Real Scan</span>
            }
        </button>
        @if (StateService.CurrentScanResult != null && !StateService.IsScanning)
        {
            <a href="/findings" class="btn-nav">Go to Findings ➡️</a>
        }
    </div>

    @if (StateService.ConsoleLogs.Any() || StateService.IsScanning || StateService.CurrentScanResult != null)
    {
        <div class="scan-console">
            <div class="console-header">
                <div class="console-status @StateService.ConsoleStatusClass">
                    <div class="dot"></div>
                    <span>@StateService.ConsoleStatusText</span>
                </div>
            </div>
            <div class="console-body">
                @if (!StateService.ConsoleLogs.Any() && !StateService.IsScanning)
                {
                    <div style="color: #64748b;">Click "Start Scan" to begin.</div>
                }
                else
                {
                    @foreach (var log in StateService.ConsoleLogs)
                    {
                        <div>@log</div>
                    }
                }
            </div>
            <div class="console-summary">
                <div class="summary-item"><div class="summary-num pass">@(StateService.CurrentScanResult?.PassCount ?? 0)</div><div class="summary-label">Passed</div></div>
                <div class="summary-item"><div class="summary-num fail">@(StateService.CurrentScanResult?.FailCount ?? 0)</div><div class="summary-label">Failed</div></div>
                <div class="summary-item"><div class="summary-num warn">@(StateService.CurrentScanResult?.WarningCount ?? 0)</div><div class="summary-label">Warning</div></div>
                <div class="summary-item"><div class="summary-num">@StateService.ScanDuration</div><div class="summary-label">Duration</div></div>
                <div class="summary-item"><div class="summary-num">@StateService.TotalChecks</div><div class="summary-label">Checks</div></div>
            </div>
        </div>
    }
</div>

@if (StateService.CurrentScanResult != null)
{
    var result = StateService.CurrentScanResult;
    var scoreColor = result.ComplianceScore > 70 ? "#10b981" : "#ef4444";
    double circumference = 326.7;
    double offset = circumference - (circumference * result.ComplianceScore / 100.0);

    int totalChecks = result.Findings.Count;
    double passPct = totalChecks > 0 ? (double)result.PassCount / totalChecks * 100 : 0;
    double failPct = totalChecks > 0 ? (double)result.FailCount / totalChecks * 100 : 0;
    double warnPct = totalChecks > 0 ? (double)result.WarningCount / totalChecks * 100 : 0;

    <div class="glass-panel">
        <div class="info-grid">
            <div class="info-card"><div class="info-label">Hostname</div><div class="info-value">@result.Hostname</div></div>
            <div class="info-card"><div class="info-label">IP Address</div><div class="info-value">@result.IpAddress</div></div>
            <div class="info-card"><div class="info-label">MAC Address</div><div class="info-value">@result.MacAddress</div></div>
            <div class="info-card"><div class="info-label">OS Edition</div><div class="info-value" style="font-size: 12px;">@result.OsVersion</div></div>
            <div class="info-card"><div class="info-label">OS Build</div><div class="info-value" style="font-size: 12px;">@result.OsBuild</div></div>
        </div>

        <div class="date-grid">
            <div class="date-card"><div class="info-label">Scan Date (Shamsi)</div><input type="text" class="date-input" value="@_shamsiDate" @onchange="OnShamsiDateChanged" /></div>
            <div class="date-card" style="border-left-color: #475569;"><div class="info-label">Scan Date (Gregorian)</div><input type="text" class="date-input" value="@_gregorianDate" readonly style="cursor: not-allowed; color: #64748b;" /></div>
        </div>

        <div class="score-container">
            <div class="score-display">
                <div class="score-ring">
                    <svg viewBox="0 0 120 120">
                        <circle class="ring-bg" cx="60" cy="60" r="52" />
                        <circle class="ring-fill" cx="60" cy="60" r="52" stroke-dasharray="@circumference" stroke-dashoffset="@offset" stroke="@scoreColor" />
                    </svg>
                    <div class="score-value"><div class="score-percent" style="color: @scoreColor;">@result.ComplianceScore%</div><div class="score-grade-text">Grade @result.Grade</div></div>
                </div>
                <div class="score-stats">
                    <div class="stat-row"><span class="stat-dot pass"></span> Passed <span class="stat-num pass">@result.PassCount</span></div>
                    <div class="stat-row"><span class="stat-dot fail"></span> Failed <span class="stat-num fail">@result.FailCount</span></div>
                    <div class="stat-row"><span class="stat-dot warn"></span> Warning <span class="stat-num warn">@result.WarningCount</span></div>
                </div>
            </div>
        </div>

        <div class="donut-section">
            <div class="donut-chart">
                <svg viewBox="0 0 36 36">
                    <circle cx="18" cy="18" r="15.915" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="3" />
                    <circle cx="18" cy="18" r="15.915" fill="none" stroke="#10b981" stroke-width="3" stroke-dasharray="@(passPct) @(100-passPct)" stroke-dashoffset="0" />
                    <circle cx="18" cy="18" r="15.915" fill="none" stroke="#ef4444" stroke-width="3" stroke-dasharray="@(failPct) @(100-failPct)" stroke-dashoffset="@(-passPct)" />
                    <circle cx="18" cy="18" r="15.915" fill="none" stroke="#f59e0b" stroke-width="3" stroke-dasharray="@(warnPct) @(100-warnPct)" stroke-dashoffset="@(-(passPct + failPct))" />
                </svg>
                <div class="donut-center"><div class="donut-num">@totalChecks</div><div class="donut-label">Checks</div></div>
            </div>
            <div class="donut-legend">
                <div class="legend-item"><span class="legend-dot pass"></span> PASS <span class="legend-num">@result.PassCount</span></div>
                <div class="legend-item"><span class="legend-dot fail"></span> FAIL <span class="legend-num">@result.FailCount</span></div>
                <div class="legend-item"><span class="legend-dot warn"></span> WARN <span class="legend-num">@result.WarningCount</span></div>
            </div>
        </div>

        <h3 style="color: #94a3b8; margin: 10px 0; font-size: 12px; text-transform: uppercase;">Category Breakdown</h3>
        <div class="category-grid">
            @foreach (var group in CategoryBreakdown)
            {
                var hasFail = group.FailCount > 0;
                <a href="@($"/findings?category={group.Category}")" class="category-card @(hasFail ? "fail" : "pass")">
                    <div class="category-title">@group.Category</div>
                    <div class="category-stats"><span class="stat-pass">@group.PassCount P</span><span class="stat-fail">@group.FailCount F</span></div>
                </a>
            }
        </div>
    </div>
}

@code {
    private string _shamsiDate = "";
    private string _gregorianDate = "";
    private string _previousShamsiDate = "";

    public class CategoryStat { public string Category { get; set; } = ""; public int PassCount { get; set; } public int FailCount { get; set; } }
    private List<CategoryStat> CategoryBreakdown { get; set; } = new();

    protected override void OnInitialized()
    {
        StateService.OnChange += HandleStateChanged;
        InitDates();
        CalculateCategoryBreakdown();
    }

    private void InitDates()
    {
        var now = DateTime.Now;
        _gregorianDate = now.ToString("yyyy/MM/dd");
        var pc = new System.Globalization.PersianCalendar();
        _shamsiDate = $"{pc.GetYear(now)}/{pc.GetMonth(now):00}/{pc.GetDayOfMonth(now):00}";
        _previousShamsiDate = _shamsiDate;
    }

    private void OnShamsiDateChanged(ChangeEventArgs e)
    {
        var newDate = e.Value?.ToString() ?? "";
        if (newDate == _shamsiDate) return;
        _previousShamsiDate = _shamsiDate;
        _shamsiDate = newDate;
        try
        {
            var pc = new System.Globalization.PersianCalendar();
            var parts = _shamsiDate.Split('/');
            if (parts.Length == 3 && int.TryParse(parts[0], out int y) && int.TryParse(parts[1], out int m) && int.TryParse(parts[2], out int d))
            {
                var gDate = pc.ToDateTime(y, m, d, 0, 0, 0, 0);
                _gregorianDate = gDate.ToString("yyyy/MM/dd");
                StateService.LogAction($"Scan date changed from {_previousShamsiDate} to {_shamsiDate}");
            }
        }
        catch { _gregorianDate = "Invalid Date"; }
    }

    private void HandleStateChanged()
    {
        InvokeAsync(() => { CalculateCategoryBreakdown(); StateHasChanged(); });
    }

    private void CalculateCategoryBreakdown()
    {
        CategoryBreakdown.Clear();
        if (StateService.CurrentScanResult == null) return;
        CategoryBreakdown = Enum.GetValues(typeof(CheckCategory)).Cast<CheckCategory>().Select(c => new CategoryStat
            {
                Category = c.ToString(),
                PassCount = StateService.CurrentScanResult.Findings.Count(f => f.Category == c && f.Status == CheckStatus.Pass),
                FailCount = StateService.CurrentScanResult.Findings.Count(f => f.Category == c && f.Status == CheckStatus.Fail)
            }).ToList();
    }

    public void Dispose() { StateService.OnChange -= HandleStateChanged; }
}