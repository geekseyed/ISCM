@page "/"
@rendermode InteractiveServer
@using ISCM.Application.Interfaces
@using ISCM.Domain.Entities
@using ISCM.Domain.Enums
@using ISCM.Web.Services
@inject IScanService ScanService
@inject ScanStateService StateService
@inject ScanHistoryService HistoryService

<PageTitle>DefenDoor - Dashboard</PageTitle>

<style>
    .glass-panel {
        background: rgba(30, 41, 59, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        margin-bottom: 30px;
    }

    .btn-scan {
        background: linear-gradient(45deg, #06b6d4, #3b82f6);
        border: none;
        padding: 15px 40px;
        color: white;
        font-size: 18px;
        font-weight: bold;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.3s;
        box-shadow: 0 0 15px rgba(6, 182, 212, 0.4);
    }

        .btn-scan:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 25px rgba(6, 182, 212, 0.6);
        }

        .btn-scan:disabled {
            background: #475569;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
        }

    .console-box {
        background: #000000;
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 15px;
        height: 120px;
        overflow-y: auto;
        margin-top: 20px;
        font-family: 'Consolas', monospace;
        font-size: 13px;
        text-align: left;
    }

    .console-line {
        color: #10b981;
        margin-bottom: 5px;
    }

    .console-time {
        color: #64748b;
        margin-right: 10px;
    }

    .console-error {
        color: #ef4444;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .info-card {
        background: rgba(15, 23, 42, 0.6);
        padding: 20px;
        border-radius: 12px;
        border-left: 4px solid #06b6d4;
    }

    .info-label {
        color: #64748b;
        font-size: 11px;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .info-value {
        color: #e2e8f0;
        font-weight: bold;
        font-family: monospace;
        font-size: 16px;
    }

    .score-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: rgba(15, 23, 42, 0.8);
        padding: 25px;
        border-radius: 12px;
        border: 1px solid #334155;
        margin-bottom: 30px;
    }

    .score-number {
        font-size: 48px;
        font-weight: 800;
    }

    .score-grade {
        font-size: 24px;
        color: #06b6d4;
        margin-left: 15px;
        background: rgba(6, 182, 212, 0.1);
        padding: 5px 15px;
        border-radius: 20px;
    }

    .category-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }

    .category-card {
        background: rgba(15, 23, 42, 0.8);
        padding: 20px;
        border-radius: 12px;
        border-top: 4px solid #06b6d4;
        text-align: center;
        transition: 0.3s;
        text-decoration: none;
        color: #e2e8f0;
        display: block;
    }

        .category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.3);
            background: rgba(6, 182, 212, 0.1);
        }

        .category-card.fail {
            border-top-color: #ef4444;
        }

        .category-card.pass {
            border-top-color: #10b981;
        }

    .category-title {
        color: #94a3b8;
        font-size: 14px;
        margin-bottom: 15px;
        text-transform: uppercase;
        font-weight: bold;
    }

    .category-stats {
        display: flex;
        justify-content: center;
        gap: 15px;
        font-size: 14px;
    }

    .stat-pass {
        color: #10b981;
        font-weight: bold;
    }

    .stat-fail {
        color: #ef4444;
        font-weight: bold;
    }

    .loading-spinner {
        border: 4px solid #334155;
        border-top: 4px solid #06b6d4;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        animation: spin 1s linear infinite;
        display: inline-block;
        vertical-align: middle;
        margin-left: 10px;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }
</style>

<div class="glass-panel">
    <div style="text-align: center; margin-bottom: 30px;">
        <h2 style="color:#e2e8f0; margin-bottom:20px; font-weight: 300; letter-spacing: 1px;">SYSTEM SECURITY DASHBOARD</h2>
        <button class="btn-scan" @onclick="StartScanAsync" disabled="@_isScanning">
            @if (_isScanning)
            {
                <span>Scanning System...</span>
                <div class="loading-spinner"></div>
            }
            else
            {
                <span>⚡ Start Real Scan</span>
            }
        </button>
    </div>

    @if (_consoleLogs.Any())
    {
        <div class="console-box">
            @foreach (var log in _consoleLogs)
            {
                <div class="console-line">
                    <span class="console-time">[@log.Time.ToString("HH:mm:ss")]</span>
                    <span class="@(log.IsError ? "console-error" : "")">@log.Message</span>
                </div>
            }
        </div>
    }

    @if (_errorMessage != null)
    {
        <div style="color: #ef4444; text-align: center; margin-top: 20px;">⚠️ @_errorMessage</div>
    }
</div>

@if (!_isScanning && StateService.CurrentScanResult != null)
{
    var result = StateService.CurrentScanResult;

    <div class="glass-panel">
        <div class="info-grid">
            <div class="info-card">
                <div class="info-label">Hostname</div>
                <div class="info-value">@result.Hostname</div>
            </div>
            <div class="info-card">
                <div class="info-label">IP Address</div>
                <div class="info-value">@result.IpAddress</div>
            </div>
            <div class="info-card">
                <div class="info-label">OS Version</div>
                <div class="info-value" style="font-size: 14px;">@result.OsVersion</div>
            </div>
        </div>

        <div class="score-container">
            <div>
                <span style="color: #64748b; font-size: 14px;">COMPLIANCE SCORE</span><br />
                <span class="score-number" style="color: @(result.ComplianceScore > 70 ? "#10b981" : "#ef4444");">@result.ComplianceScore%</span>
                <span class="score-grade">Grade @result.Grade</span>
            </div>
            <div style="text-align: right;">
                <div style="display: flex; gap: 25px; font-size: 18px;">
                    <div><span class="stat-pass">@result.PassCount</span> <span style="color:#64748b; font-size:12px;">PASS</span></div>
                    <div><span class="stat-fail">@result.FailCount</span> <span style="color:#64748b; font-size:12px;">FAIL</span></div>
                    <div><span style="color: #f59e0b; font-weight: bold;">@result.WarningCount</span> <span style="color:#64748b; font-size:12px;">WARN</span></div>
                </div>
            </div>
        </div>

        <h3 style="color: #94a3b8; margin-bottom: 15px; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">Category Breakdown</h3>
        <div class="category-grid">
            @foreach (var group in CategoryBreakdown)
            {
                var hasFail = group.FailCount > 0;
                var cardClass = hasFail ? "fail" : "pass";

                <a href="@($"/findings?category={group.Category}")" class="category-card @cardClass">
                    <div class="category-title">@group.Category</div>
                    <div class="category-stats">
                        <span class="stat-pass">@group.PassCount Pass</span>
                        <span class="stat-fail">@group.FailCount Fail</span>
                    </div>
                </a>
            }
        </div>
    </div>
}

@code {
    private bool _isScanning;
    private string? _errorMessage;

    public class ConsoleLogEntry
    {
        public DateTime Time { get; set; }
        public string Message { get; set; } = "";
        public bool IsError { get; set; }
    }

    private List<ConsoleLogEntry> _consoleLogs = new();

    public class CategoryStat
    {
        public string Category { get; set; } = "";
        public int PassCount { get; set; }
        public int FailCount { get; set; }
    }
    private List<CategoryStat> CategoryBreakdown { get; set; } = new();

    protected override void OnInitialized()
    {
        CalculateCategoryBreakdown();
    }

    private async Task StartScanAsync()
    {
        if (_isScanning) return;

        try
        {
            _isScanning = true;
            _errorMessage = null;
            _consoleLogs.Clear();
            StateHasChanged();

            var progress = new Progress<string>(status =>
            {
                _consoleLogs.Add(new ConsoleLogEntry { Time = DateTime.Now, Message = status });
                StateHasChanged();
            });

            var scanResult = await ScanService.RunScanAsync(ScanMode.Full, progress);
            StateService.CurrentScanResult = scanResult;
            HistoryService.AddScan(scanResult);

            CalculateCategoryBreakdown();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            _consoleLogs.Add(new ConsoleLogEntry { Time = DateTime.Now, Message = $"Error: {ex.Message}", IsError = true });
        }
        finally
        {
            _isScanning = false;
        }
    }

    private void CalculateCategoryBreakdown()
    {
        CategoryBreakdown.Clear();
        if (StateService.CurrentScanResult == null) return;

        var allCategories = Enum.GetValues(typeof(CheckCategory)).Cast<CheckCategory>();

        CategoryBreakdown = allCategories.Select(c => new CategoryStat
            {
                Category = c.ToString(),
                PassCount = StateService.CurrentScanResult.Findings.Count(f => f.Category == c && f.Status == CheckStatus.Pass),
                FailCount = StateService.CurrentScanResult.Findings.Count(f => f.Category == c && f.Status == CheckStatus.Fail)
            }).ToList();
    }
}