@page "/"
@rendermode InteractiveServer
@using ISCM.Application.Interfaces
@using ISCM.Domain.Entities
@using ISCM.Domain.Enums
@using ISCM.Web.Services
@inject IScanService ScanService
@inject ScanStateService StateService

<PageTitle>DefenDoor - Dashboard</PageTitle>

<style>
    .glass-panel {
        background: rgba(30, 41, 59, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
    }

    .btn-scan {
        background: linear-gradient(45deg, #06b6d4, #3b82f6);
        border: none;
        padding: 12px 30px;
        color: white;
        font-size: 18px;
        font-weight: bold;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.3s;
        box-shadow: 0 0 15px rgba(6, 182, 212, 0.4);
    }

        .btn-scan:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 25px rgba(6, 182, 212, 0.6);
        }

        .btn-scan:disabled {
            background: #475569;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
        }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin: 30px 0;
    }

    .info-card {
        background: rgba(15, 23, 42, 0.6);
        padding: 15px;
        border-radius: 8px;
        border-left: 4px solid #06b6d4;
    }

    .info-label {
        color: #94a3b8;
        font-size: 12px;
        margin-bottom: 5px;
        text-transform: uppercase;
    }

    .info-value {
        color: #e2e8f0;
        font-weight: bold;
        font-family: monospace;
    }

    .loading-spinner {
        border: 4px solid #334155;
        border-top: 4px solid #06b6d4;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        animation: spin 1s linear infinite;
        display: inline-block;
        vertical-align: middle;
        margin-left: 10px;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }
</style>

<div class="glass-panel">
    <div style="text-align: center; margin-bottom: 30px;">
        <h2 style="color:#e2e8f0; margin-bottom:20px;">System Security Dashboard</h2>
        <button class="btn-scan" @onclick="StartScanAsync" disabled="@_isScanning">
            @if (_isScanning)
            {
                <span>Scanning System...</span>
                <div class="loading-spinner"></div>
            }
            else
            {
                <span>⚡ Start Real Scan</span>
            }
        </button>

        @if (_isScanning && _currentScanStatus != null)
        {
            <div style="color: #06b6d4; margin-top: 15px; font-family: monospace; font-size: 14px;">
                ⚙️ @_currentScanStatus
            </div>
        }
    </div>

    @if (_errorMessage != null)
    {
        <div style="color: #ef4444; text-align: center; margin-bottom: 20px;">⚠️ @_errorMessage</div>
    }

    @if (StateService.CurrentScanResult != null)
    {
        var result = StateService.CurrentScanResult;
        <div class="info-grid">
            <div class="info-card">
                <div class="info-label">Hostname</div>
                <div class="info-value">@result.Hostname</div>
            </div>
            <div class="info-card">
                <div class="info-label">IP Address</div>
                <div class="info-value">@result.IpAddress</div>
            </div>
            <div class="info-card">
                <div class="info-label">OS Version</div>
                <div class="info-value" style="font-size: 12px;">@result.OsVersion</div>
            </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; background: #0f172a; padding: 15px; border-radius: 8px;">
            <div>
                <span style="font-size: 14px; color: #94a3b8;">Compliance Score:</span>
                <span style="font-size: 32px; font-weight: bold; color: @(result.ComplianceScore > 70 ? "#10b981" : "#ef4444"); margin-left: 10px;">@result.ComplianceScore%</span>
                <span style="font-size: 20px; color: #06b6d4; margin-left: 10px;">(Grade @result.Grade)</span>
            </div>
            <div>
                <span style="color: #10b981; font-weight: bold; margin-right: 10px;">PASS: @result.PassCount</span>
                <span style="color: #ef4444; font-weight: bold; margin-right: 10px;">FAIL: @result.FailCount</span>
                <span style="color: #f59e0b; font-weight: bold;">WARN: @result.WarningCount</span>
            </div>
        </div>

        <p style="text-align:center; color:#94a3b8; margin-top:20px;">
            Go to the <a href="/findings" style="color:#06b6d4; text-decoration:none; font-weight:bold;">Findings</a> tab to see detailed results.
        </p>
    }
</div>

@code {
    private bool _isScanning;
    private string? _errorMessage;
    private string? _currentScanStatus;

    protected override void OnInitialized()
    {
        // اگر قبلا اسکن شده بود، هیچ کاری نمی‌کنیم
    }

    private async Task StartScanAsync()
    {
        if (_isScanning) return;

        try
        {
            _isScanning = true;
            _errorMessage = null;
            _currentScanStatus = "Starting...";
            StateHasChanged();

            var progress = new Progress<string>(status =>
            {
                _currentScanStatus = status;
                StateHasChanged();
            });

            var scanResult = await ScanService.RunScanAsync(ScanMode.Full, progress);

            // ذخیره نتیجه در سرویس مشترک تا تب‌های دیگر هم ببینند
            StateService.CurrentScanResult = scanResult;

            _currentScanStatus = null;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isScanning = false;
        }
    }
}