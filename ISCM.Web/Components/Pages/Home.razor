@page "/"
@rendermode InteractiveServer
@using ISCM.Application.Interfaces
@using ISCM.Domain.Entities
@using ISCM.Domain.Enums
@using ISCM.Web.Services
@inject ScanStateService StateService
@implements IDisposable

<PageTitle>DefenDoor - Dashboard</PageTitle>

<style>
    .glass-panel {
        background: rgba(30, 41, 59, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 15px;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        margin-bottom: 10px;
    }

    .btn-scan {
        background: linear-gradient(45deg, #06b6d4, #3b82f6);
        border: none;
        padding: 10px 25px;
        color: white;
        font-size: 15px;
        font-weight: bold;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.3s;
        box-shadow: 0 0 15px rgba(6, 182, 212, 0.4);
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-scan:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 25px rgba(6, 182, 212, 0.6);
        }

        .btn-scan:disabled {
            background: #475569;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
        }

    .btn-nav {
        background: #334155;
        border: none;
        padding: 10px 25px;
        color: #06b6d4;
        font-size: 15px;
        font-weight: bold;
        border-radius: 8px;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        margin-left: 10px;
    }

    /* استایل‌های کنسول اسکن */
    .scan-console {
        background: #0a0e1a;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 8px;
        margin-top: 15px;
        overflow: hidden;
    }

    .console-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 14px;
        background: #1a2033;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        font-size: 12px;
        color: #94a3b8;
    }

    .console-status {
        display: flex;
        align-items: center;
        gap: 6px;
        font-family: 'Consolas', monospace;
        font-size: 11px;
    }

        .console-status .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #64748b;
        }

        .console-status.scanning .dot {
            background: #f59e0b;
            animation: pulse 1s infinite;
        }

        .console-status.complete .dot {
            background: #10b981;
        }

        .console-status.failed .dot {
            background: #ef4444;
        }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.3;
        }
    }

    .console-body {
        height: 100px;
        overflow-y: auto;
        padding: 8px 14px;
        font-family: 'Consolas', monospace;
        font-size: 12px;
        line-height: 1.5;
        color: #10b981;
    }

        .console-body::-webkit-scrollbar {
            width: 4px;
        }

        .console-body::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.1);
            border-radius: 2px;
        }

    .console-summary {
        display: flex;
        border-top: 1px solid rgba(255,255,255,0.1);
        background: #1a2033;
    }

    .summary-item {
        flex: 1;
        padding: 8px 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        border-right: 1px solid rgba(255,255,255,0.06);
    }

        .summary-item:last-child {
            border-right: none;
        }

    .summary-num {
        font-size: 16px;
        font-weight: 700;
        font-family: 'Consolas', monospace;
        color: #e2e8f0;
    }

        .summary-num.pass {
            color: #10b981;
        }

        .summary-num.fail {
            color: #ef4444;
        }

        .summary-num.warn {
            color: #f59e0b;
        }

    .summary-label {
        font-size: 9px;
        color: #64748b;
        text-transform: uppercase;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin: 15px 0;
    }

    .info-card {
        background: rgba(15, 23, 42, 0.6);
        padding: 10px;
        border-radius: 8px;
        border-left: 3px solid #06b6d4;
    }

    .info-label {
        color: #64748b;
        font-size: 10px;
        margin-bottom: 3px;
        text-transform: uppercase;
    }

    .info-value {
        color: #e2e8f0;
        font-weight: bold;
        font-family: monospace;
        font-size: 13px;
    }

    .date-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 15px;
    }

    .date-card {
        background: rgba(15, 23, 42, 0.6);
        padding: 10px;
        border-radius: 8px;
        border-left: 3px solid #f59e0b;
    }

    .date-input {
        background: #0f172a;
        border: 1px solid #334155;
        padding: 4px 8px;
        border-radius: 4px;
        color: white;
        width: 100%;
        font-family: monospace;
        font-size: 13px;
    }

    .score-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: rgba(15, 23, 42, 0.8);
        padding: 12px;
        border-radius: 8px;
        border: 1px solid #334155;
        margin-bottom: 15px;
    }

    .score-number {
        font-size: 32px;
        font-weight: 800;
    }

    .score-grade {
        font-size: 16px;
        color: #06b6d4;
        margin-left: 10px;
        background: rgba(6, 182, 212, 0.1);
        padding: 4px 12px;
        border-radius: 15px;
    }

    .category-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
    }

    .category-card {
        background: rgba(15, 23, 42, 0.8);
        padding: 10px;
        border-radius: 8px;
        border-top: 3px solid #06b6d4;
        text-align: center;
        transition: 0.3s;
        text-decoration: none;
        color: #e2e8f0;
        display: block;
    }

        .category-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
            background: rgba(6, 182, 212, 0.1);
        }

        .category-card.fail {
            border-top-color: #ef4444;
        }

        .category-card.pass {
            border-top-color: #10b981;
        }

    .category-title {
        color: #94a3b8;
        font-size: 11px;
        margin-bottom: 5px;
        text-transform: uppercase;
        font-weight: bold;
    }

    .category-stats {
        display: flex;
        justify-content: center;
        gap: 10px;
        font-size: 12px;
    }

    .stat-pass {
        color: #10b981;
        font-weight: bold;
    }

    .stat-fail {
        color: #ef4444;
        font-weight: bold;
    }

    .loading-spinner {
        border: 3px solid rgba(255,255,255,0.3);
        border-top: 3px solid #fff;
        border-radius: 50%;
        width: 14px;
        height: 14px;
        animation: spin 1s linear infinite;
        display: inline-block;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }
</style>

<div class="glass-panel">
    <div style="text-align: center; margin-bottom: 10px;">
        <button class="btn-scan" @onclick="StateService.ExecuteScanAsync" disabled="@StateService.IsScanning">
            @if (StateService.IsScanning)
            {
                <span>Scanning System...</span> <div class="loading-spinner"></div>
            }
            else
            {
                <span>⚡ Start Real Scan</span>
            }
        </button>
        @if (StateService.CurrentScanResult != null && !StateService.IsScanning)
        {
            <a href="/findings" class="btn-nav">Go to Findings ➡️</a>
        }
    </div>

    @if (StateService.ConsoleLogs.Any() || StateService.IsScanning || StateService.CurrentScanResult != null)
    {
        <div class="scan-console">
            <div class="console-header">
                <div class="console-status @StateService.ConsoleStatusClass">
                    <div class="dot"></div>
                    <span>@StateService.ConsoleStatusText</span>
                </div>
            </div>
            <div class="console-body">
                @if (!StateService.ConsoleLogs.Any() && !StateService.IsScanning)
                {
                    <div style="color: #64748b;">Click "Start Scan" to begin.</div>
                }
                else
                {
                    @foreach (var log in StateService.ConsoleLogs)
                    {
                        <div>@log</div>
                    }
                }
            </div>
            <div class="console-summary">
                <div class="summary-item">
                    <div class="summary-num pass">@(StateService.CurrentScanResult?.PassCount ?? 0)</div>
                    <div class="summary-label">Passed</div>
                </div>
                <div class="summary-item">
                    <div class="summary-num fail">@(StateService.CurrentScanResult?.FailCount ?? 0)</div>
                    <div class="summary-label">Failed</div>
                </div>
                <div class="summary-item">
                    <div class="summary-num warn">@(StateService.CurrentScanResult?.WarningCount ?? 0)</div>
                    <div class="summary-label">Warning</div>
                </div>
                <div class="summary-item">
                    <div class="summary-num">@StateService.ScanDuration</div>
                    <div class="summary-label">Duration</div>
                </div>
                <div class="summary-item">
                    <div class="summary-num">@StateService.TotalChecks</div>
                    <div class="summary-label">Checks</div>
                </div>
            </div>
        </div>
    }
</div>

@if (StateService.CurrentScanResult != null)
{
    var result = StateService.CurrentScanResult;
    <div class="glass-panel">
        <div class="info-grid">
            <div class="info-card"><div class="info-label">Hostname</div><div class="info-value">@result.Hostname</div></div>
            <div class="info-card"><div class="info-label">IP Address</div><div class="info-value">@result.IpAddress</div></div>
            <div class="info-card"><div class="info-label">MAC Address</div><div class="info-value">@result.MacAddress</div></div>
            <div class="info-card"><div class="info-label">OS Edition</div><div class="info-value" style="font-size: 12px;">@result.OsVersion</div></div>
            <div class="info-card"><div class="info-label">OS Build</div><div class="info-value" style="font-size: 12px;">@result.OsBuild</div></div>
        </div>

        <div class="date-grid">
            <div class="date-card">
                <div class="info-label">Scan Date (Shamsi)</div>
                <input type="text" class="date-input" value="@_shamsiDate" @onchange="OnShamsiDateChanged" />
            </div>
            <div class="date-card" style="border-left-color: #475569;">
                <div class="info-label">Scan Date (Gregorian)</div>
                <input type="text" class="date-input" value="@_gregorianDate" readonly style="cursor: not-allowed; color: #64748b;" />
            </div>
        </div>

        <div class="score-container">
            <div>
                <span style="color: #64748b; font-size: 11px;">COMPLIANCE SCORE</span><br />
                <span class="score-number" style="color: @(result.ComplianceScore > 70 ? "#10b981" : "#ef4444");">@result.ComplianceScore%</span>
                <span class="score-grade">Grade @result.Grade</span>
            </div>
            <div style="text-align: right;">
                <div style="display: flex; gap: 15px; font-size: 14px;">
                    <div><span class="stat-pass">@result.PassCount</span> <span style="color:#64748b; font-size:10px;">PASS</span></div>
                    <div><span class="stat-fail">@result.FailCount</span> <span style="color:#64748b; font-size:10px;">FAIL</span></div>
                    <div><span style="color: #f59e0b; font-weight: bold;">@result.WarningCount</span> <span style="color:#64748b; font-size:10px;">WARN</span></div>
                </div>
            </div>
        </div>

        <h3 style="color: #94a3b8; margin-bottom: 10px; font-size: 12px; text-transform: uppercase;">Category Breakdown</h3>
        <div class="category-grid">
            @foreach (var group in CategoryBreakdown)
            {
                var hasFail = group.FailCount > 0;
                <a href="@($"/findings?category={group.Category}")" class="category-card @(hasFail ? "fail" : "pass")">
                    <div class="category-title">@group.Category</div>
                    <div class="category-stats">
                        <span class="stat-pass">@group.PassCount P</span>
                        <span class="stat-fail">@group.FailCount F</span>
                    </div>
                </a>
            }
        </div>
    </div>
}

@code {
    private string _shamsiDate = "";
    private string _gregorianDate = "";
    private string _previousShamsiDate = "";

    public class CategoryStat { public string Category { get; set; } = ""; public int PassCount { get; set; } public int FailCount { get; set; } }
    private List<CategoryStat> CategoryBreakdown { get; set; } = new();

    protected override void OnInitialized()
    {
        StateService.OnChange += HandleStateChanged;
        InitDates();
        CalculateCategoryBreakdown();
    }

    private void InitDates()
    {
        var now = DateTime.Now;
        _gregorianDate = now.ToString("yyyy/MM/dd");
        var pc = new System.Globalization.PersianCalendar();
        _shamsiDate = $"{pc.GetYear(now)}/{pc.GetMonth(now):00}/{pc.GetDayOfMonth(now):00}";
        _previousShamsiDate = _shamsiDate;
    }

    private void OnShamsiDateChanged(ChangeEventArgs e)
    {
        var newDate = e.Value?.ToString() ?? "";
        if (newDate == _shamsiDate) return;
        _previousShamsiDate = _shamsiDate;
        _shamsiDate = newDate;
        try
        {
            var pc = new System.Globalization.PersianCalendar();
            var parts = _shamsiDate.Split('/');
            if (parts.Length == 3 && int.TryParse(parts[0], out int y) && int.TryParse(parts[1], out int m) && int.TryParse(parts[2], out int d))
            {
                var gDate = pc.ToDateTime(y, m, d, 0, 0, 0, 0);
                _gregorianDate = gDate.ToString("yyyy/MM/dd");
                StateService.LogAction($"Scan date changed from {_previousShamsiDate} to {_shamsiDate}");
            }
        }
        catch { _gregorianDate = "Invalid Date"; }
    }

    private void HandleStateChanged()
    {
        InvokeAsync(() => { CalculateCategoryBreakdown(); StateHasChanged(); });
    }

    private void CalculateCategoryBreakdown()
    {
        CategoryBreakdown.Clear();
        if (StateService.CurrentScanResult == null) return;
        CategoryBreakdown = Enum.GetValues(typeof(CheckCategory)).Cast<CheckCategory>().Select(c => new CategoryStat
            {
                Category = c.ToString(),
                PassCount = StateService.CurrentScanResult.Findings.Count(f => f.Category == c && f.Status == CheckStatus.Pass),
                FailCount = StateService.CurrentScanResult.Findings.Count(f => f.Category == c && f.Status == CheckStatus.Fail)
            }).ToList();
    }

    public void Dispose() { StateService.OnChange -= HandleStateChanged; }
}