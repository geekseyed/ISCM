@page "/activity"
@rendermode InteractiveServer
@using ISCM.Web.Services
@inject ScanHistoryService HistoryService

<PageTitle>DefenDoor - Activity Log</PageTitle>

<style>
    .glass-panel {
        background: rgba(30, 41, 59, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    th {
        text-align: left;
        padding: 12px;
        background: #0f172a;
        color: #06b6d4;
        border-bottom: 2px solid #334155;
    }

    td {
        padding: 12px;
        border-bottom: 1px solid #334155;
    }

    .grade-badge {
        padding: 4px 12px;
        border-radius: 12px;
        font-weight: bold;
    }
</style>

<div class="glass-panel">
    <h2 style="color:#e2e8f0; margin-bottom:20px;">Scan Activity Log</h2>

    @if (!HistoryService.History.Any())
    {
        <p style="color:#94a3b8; text-align:center; padding:40px;">
            No scans have been performed yet in this session. <br /> Go to <a href="/" style="color:#06b6d4;">Dashboard</a> to start a new scan.
        </p>
    }
    else
    {
        <p style="color:#94a3b8; margin-bottom:10px;">Total scans in this session: @HistoryService.History.Count</p>
        <table>
            <thead>
                <tr>
                    <th>Scan Time</th>
                    <th>Hostname</th>
                    <th>Compliance Score</th>
                    <th>Grade</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in HistoryService.History)
                {
                    <tr>
                        <td style="color: #94a3b8;">@entry.ScanTime.ToString("g")</td>
                        <td style="color: #e2e8f0; font-family: monospace;">@entry.Hostname</td>
                        <td style="color: @(entry.ComplianceScore > 70 ? "#10b981" : "#ef4444"); font-weight: bold;">@entry.ComplianceScore%</td>
                        <td>
                            <span class="grade-badge" style="background: rgba(6, 182, 212, 0.2); color: #06b6d4;">@entry.Grade</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>