@inherits LayoutComponentBase
@using ISCM.Web.Services
@inject ScanStateService StateService
@inject ThemeService ThemeService
@implements IDisposable

<style>
    html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        overflow: hidden;
    }

    body {
        background-color: #0f172a;
        color: #e2e8f0;
        font-family: 'Segoe UI', Tahoma, sans-serif;
    }

    .app-container {
        display: flex;
        flex-direction: column;
        height: 100vh;
        overflow: hidden;
        background-color: #0f172a;
        background-image: linear-gradient(rgba(15, 23, 42, 0.9), rgba(15, 23, 42, 0.95)), url('https://images.unsplash.com/photo-1451187580459-43490279c0fa?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80');
        background-size: cover;
        color: #e2e8f0;
        font-family: 'Segoe UI', Tahoma, sans-serif;
    }

    .app-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 40px;
        background: rgba(15, 23, 42, 0.8);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid #334155;
        flex-shrink: 0;
        position: relative;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* ── EDIT (گروه C): چراغ Connected حرفه‌ای و بزرگ‌تر ── */
    .host-pill {
        display: flex;
        align-items: center;
        gap: 12px;
        background: rgba(30, 41, 59, 0.5);
        border: 1px solid #334155;
        padding: 10px 20px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: bold;
        color: #e2e8f0;
        transition: all 0.3s ease;
        font-family: 'Consolas', monospace;
        letter-spacing: 0.5px;
    }

    .host-pill.online {
        border-color: rgba(16, 185, 129, 0.4);
        box-shadow: 0 0 12px rgba(16, 185, 129, 0.15);
    }

    .host-pill.offline {
        background: rgba(239, 68, 68, 0.15);
        border-color: rgba(239, 68, 68, 0.5);
        color: #ef4444;
        box-shadow: 0 0 20px rgba(239, 68, 68, 0.3);
        animation: offlinePillPulse 1.2s ease-in-out infinite;
    }

    @@keyframes offlinePillPulse {
        0%, 100% { box-shadow: 0 0 20px rgba(239, 68, 68, 0.3); }
        50% { box-shadow: 0 0 30px rgba(239, 68, 68, 0.6); }
    }

    .host-pill .dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        position: relative;
        flex-shrink: 0;
    }

    /* EDIT: چراغ online با ضربان آرام */
    .host-pill.online .dot {
        background: #10b981;
        box-shadow: 0 0 10px #10b981, 0 0 20px rgba(16, 185, 129, 0.4);
        animation: onlinePulse 2.5s ease-in-out infinite;
    }

    .host-pill.online .dot::after {
        content: '';
        position: absolute;
        inset: -4px;
        border-radius: 50%;
        border: 2px solid rgba(16, 185, 129, 0.4);
        animation: onlineRing 2.5s ease-out infinite;
    }

    @@keyframes onlinePulse {
        0%, 100% {
            background: #10b981;
            box-shadow: 0 0 10px #10b981, 0 0 20px rgba(16, 185, 129, 0.4);
        }
        50% {
            background: #34d399;
            box-shadow: 0 0 16px #34d399, 0 0 28px rgba(16, 185, 129, 0.6);
        }
    }

    @@keyframes onlineRing {
        0% { transform: scale(0.8); opacity: 0.8; }
        100% { transform: scale(1.8); opacity: 0; }
    }

    /* EDIT: چراغ offline با چشمک سریع */
    .host-pill.offline .dot {
        background: #ef4444;
        box-shadow: 0 0 12px #ef4444, 0 0 24px rgba(239, 68, 68, 0.6);
        animation: offlineBlink 0.7s ease-in-out infinite;
    }

    @@keyframes offlineBlink {
        0%, 100% {
            background: #ef4444;
            box-shadow: 0 0 12px #ef4444, 0 0 24px rgba(239, 68, 68, 0.6);
            opacity: 1;
        }
        50% {
            background: #7f1d1d;
            box-shadow: 0 0 4px #ef4444;
            opacity: 0.4;
        }
    }

    .host-pill .status-text {
        font-weight: bold;
    }

    .path-pill {
        background: rgba(30, 41, 59, 0.5);
        border: 1px solid #334155;
        padding: 8px 16px;
        border-radius: 8px;
        font-family: 'Consolas', monospace;
        font-size: 12px;
        color: #94a3b8;
    }

    .brand-center {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .logo-svg {
        filter: drop-shadow(0 0 8px #06b6d4);
    }

    .brand-name {
        color: #e2e8f0;
        text-shadow: 0 0 5px #06b6d4, 0 0 15px #06b6d4;
        font-size: 22px;
        font-weight: bold;
        letter-spacing: 1px;
    }

    .brand-sub {
        color: #64748b;
        font-size: 10px;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-top: 2px;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .theme-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        background: rgba(30, 41, 59, 0.5);
        border: 1px solid #334155;
        color: #e2e8f0;
        padding: 8px 16px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 13px;
        font-weight: bold;
        transition: 0.2s;
    }

    .theme-btn:hover { border-color: #06b6d4; }

    .top-nav {
        background: rgba(15, 23, 42, 0.6);
        padding: 10px 40px;
        display: flex;
        gap: 10px;
        border-bottom: 1px solid #1e293b;
        flex-shrink: 0;
    }

    .nav-link {
        color: #94a3b8;
        text-decoration: none;
        padding: 8px 20px;
        border-radius: 6px;
        font-weight: 500;
        transition: 0.2s;
    }

    .nav-link:hover {
        color: #e2e8f0;
        background: rgba(51, 65, 85, 0.5);
    }

    .nav-link.active {
        color: #06b6d4;
        background: rgba(6, 182, 212, 0.1);
        border-bottom: 2px solid #06b6d4;
        border-radius: 0;
    }

    .nav-badge {
        background: rgba(6, 182, 212, 0.15);
        color: #06b6d4;
        border-radius: 10px;
        padding: 1px 8px;
        font-size: 11px;
        font-family: 'Consolas', monospace;
        margin-left: 6px;
    }

    .nav-right { margin-left: auto; }

    .nav-locked {
        pointer-events: none;
        opacity: 0.4;
        cursor: not-allowed;
    }

    .main-content {
        flex-grow: 1;
        overflow-y: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
        padding: 20px 40px;
        max-width: 1400px;
        width: 100%;
        margin: 0 auto;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
    }

    .main-content::-webkit-scrollbar { display: none; }

    .reconnect-modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(239, 68, 68, 0.9);
        z-index: 9999;
        justify-content: center;
        align-items: center;
    }

    .reconnect-modal.components-reconnect-show, .reconnect-modal.components-reconnect-failed {
        display: flex;
    }

    .reconnect-box {
        background: #1e293b;
        padding: 40px;
        border-radius: 12px;
        text-align: center;
    }

    .reconnect-text {
        color: #ef4444;
        font-size: 24px;
        font-weight: bold;
        margin-top: 10px;
    }

    /* تم روشن */
    .app-container.light {
        background: #f1f5f9;
        color: #0f172a;
    }

    .app-container.light h1, .app-container.light h2, .app-container.light h3 { color: #0f172a !important; }
    .app-container.light p { color: #475569 !important; }
    .app-container.light strong, .app-container.light b { color: #0f172a !important; }

    .app-container.light .app-header {
        background: rgba(255, 255, 255, 0.9);
        border-bottom: 1px solid #e2e8f0;
    }

    .app-container.light .host-pill {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        color: #334155;
    }

    .app-container.light .host-pill.online {
        border-color: rgba(16, 185, 129, 0.4);
        box-shadow: 0 0 12px rgba(16, 185, 129, 0.15);
    }

    .app-container.light .host-pill.offline {
        background: rgba(239, 68, 68, 0.08);
        border-color: rgba(239, 68, 68, 0.5);
        color: #dc2626;
    }

    .app-container.light .path-pill {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        color: #64748b;
    }

    .app-container.light .brand-name {
        color: #0f172a;
        text-shadow: none;
    }

    .app-container.light .brand-sub { color: #64748b; }

    .app-container.light .theme-btn {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        color: #334155;
    }

    .app-container.light .theme-btn:hover { border-color: #0891b2; }

    .app-container.light .top-nav {
        background: rgba(255, 255, 255, 0.7);
        border-bottom: 1px solid #e2e8f0;
    }

    .app-container.light .nav-link { color: #475569; }
    .app-container.light .nav-link:hover {
        color: #0f172a;
        background: rgba(226, 232, 240, 0.6);
    }
    .app-container.light .nav-link.active {
        color: #0891b2;
        background: rgba(6, 182, 212, 0.08);
    }

    .app-container.light .nav-badge {
        background: rgba(6, 182, 212, 0.15);
        color: #0891b2;
    }

    .app-container.light .glass-panel {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
    }

    .app-container.light .panel-title { color: #475569; }
    .app-container.light .btn-edit {
        background: #e2e8f0;
        color: #0f172a;
    }
    .app-container.light .btn-edit:hover { background: #cbd5e1; }
    .app-container.light .stat-row {
        color: #475569;
        border-bottom-color: #e2e8f0;
    }
    .app-container.light .stat-num { color: #0f172a; }
    .app-container.light .score-percent { color: #0f172a; }
    .app-container.light .score-grade-text { color: #64748b; }
    .app-container.light .ring-bg { stroke: rgba(15, 23, 42, 0.1); }
    .app-container.light .donut-num { color: #0f172a; }
    .app-container.light .donut-label { color: #64748b; }
    .app-container.light .legend-item { color: #475569; }
    .app-container.light .legend-num { color: #0f172a; }
    .app-container.light .sys-row { border-bottom-color: #e2e8f0; }
    .app-container.light .sys-label { color: #64748b; }
    .app-container.light .sys-value { color: #0f172a; }
    .app-container.light .sys-input {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        color: #0f172a;
    }
    .app-container.light .btn-cancel { background: #94a3b8; }
    .app-container.light .category-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
    }
    .app-container.light .category-card:hover { border-color: #0891b2; }
    .app-container.light .category-title { color: #475569; }
    .app-container.light .category-sub { color: #64748b; }
    .app-container.light .progress-track { background: #e2e8f0; }
    .app-container.light .btn-back {
        background: #e2e8f0;
        color: #0891b2;
    }
</style>

<div class="app-container @(ThemeService.IsDark ? "" : "light")">
    <div class="app-header">
        <div class="header-left">
            @* EDIT (گروه C): چراغ Connected حرفه‌ای با حالت online/offline *@
            <div class="host-pill @(StateService.IsConnected ? "online" : "offline")">
                <span class="dot"></span>
                <span class="status-text">@(StateService.IsConnected ? "CONNECTED" : "DISCONNECTED")</span>
            </div>
        </div>

        <div class="brand-center">
            <svg class="logo-svg" width="40" height="40" viewBox="0 0 100 100">
                <path d="M50 5 L90 20 V50 C90 75 70 90 50 95 C30 90 10 75 10 50 V20 Z" fill="rgba(15, 23, 42, 0.8)" stroke="#06b6d4" stroke-width="3" />
                <path d="M35 50 L45 60 L65 35" stroke="#ffffff" stroke-width="5" fill="none" stroke-linecap="round" stroke-linejoin="round" style="filter: drop-shadow(0 0 5px #ffffff);" />
            </svg>
            <div>
                <div class="brand-name">DefenDoor</div>
                <div class="brand-sub">Industrial Security Compliance</div>
            </div>
        </div>

        <div class="header-right">
            <button class="theme-btn" @onclick="ThemeService.ToggleTheme">
                @(ThemeService.IsDark ? "🌙 Dark" : "☀️ Light")
            </button>
            <div class="path-pill">v2.0 Beta</div>
        </div>
    </div>

    <div class="top-nav">
        <NavLink class="@GetNavClass()" href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
        <NavLink class="@GetNavClass()" href="/findings">Findings <span class="nav-badge">@FindingsCount</span></NavLink>
        <NavLink class="@GetNavClass()" href="/reports">Reports</NavLink>
        <NavLink class="@GetNavClass()" href="/settings">Settings</NavLink>
        <NavLink class="@GetActivityNavClass()" href="/activity">Activity <span class="nav-badge">@ActivityCount</span></NavLink>
    </div>

    <div class="main-content">
        @Body
    </div>
</div>

<div id="components-reconnect-modal" class="reconnect-modal">
    <div class="reconnect-box">
        <div style="font-size: 48px;">🔌</div>
        <div class="reconnect-text">Connection to host lost!</div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        StateService.OnChange += HandleStateChanged;
        ThemeService.OnChange += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private string GetNavClass()
    {
        return StateService.IsScanning ? "nav-link nav-locked" : "nav-link";
    }

    private string GetActivityNavClass()
    {
        return StateService.IsScanning ? "nav-link nav-locked nav-right" : "nav-link nav-right";
    }

    private int FindingsCount => StateService.CurrentScanResult?.Findings.Count ?? 0;

    private int ActivityCount => StateService.EventLog.Count;

    public void Dispose()
    {
        StateService.OnChange -= HandleStateChanged;
        ThemeService.OnChange -= HandleStateChanged;
    }
}