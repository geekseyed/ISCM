@inherits LayoutComponentBase
@using ISCM.Web.Services
@inject ScanStateService StateService
@inject ThemeService ThemeService
@implements IDisposable

<style>
    html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        overflow: hidden;
    }

    body {
        background-color: #0f172a;
        color: #e2e8f0;
        font-family: 'Segoe UI', Tahoma, sans-serif;
    }

    .app-container {
        display: flex;
        flex-direction: column;
        height: 100vh;
        overflow: hidden;
        background-color: #0f172a;
        background-image: linear-gradient(rgba(15, 23, 42, 0.9), rgba(15, 23, 42, 0.95)), url('https://images.unsplash.com/photo-1451187580459-43490279c0fa?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80');
        background-size: cover;
        color: #e2e8f0;
        font-family: 'Segoe UI', Tahoma, sans-serif;
    }

    .app-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 40px;
        background: rgba(15, 23, 42, 0.8);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid #334155;
        flex-shrink: 0;
        position: relative;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .host-pill {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(30, 41, 59, 0.5);
        border: 1px solid #334155;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 13px;
        color: #e2e8f0;
    }

        .host-pill .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #10b981;
            box-shadow: 0 0 8px #10b981;
        }

    .path-pill {
        background: rgba(30, 41, 59, 0.5);
        border: 1px solid #334155;
        padding: 8px 16px;
        border-radius: 8px;
        font-family: 'Consolas', monospace;
        font-size: 12px;
        color: #94a3b8;
    }

    .brand-center {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .logo-svg {
        filter: drop-shadow(0 0 8px #06b6d4);
    }

    .brand-name {
        color: #e2e8f0;
        text-shadow: 0 0 5px #06b6d4, 0 0 15px #06b6d4;
        font-size: 22px;
        font-weight: bold;
        letter-spacing: 1px;
    }

    .brand-sub {
        color: #64748b;
        font-size: 10px;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-top: 2px;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .theme-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        background: rgba(30, 41, 59, 0.5);
        border: 1px solid #334155;
        color: #e2e8f0;
        padding: 8px 16px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 13px;
        font-weight: bold;
        transition: 0.2s;
    }

        .theme-btn:hover {
            border-color: #06b6d4;
        }

    .top-nav {
        background: rgba(15, 23, 42, 0.6);
        padding: 10px 40px;
        display: flex;
        gap: 10px;
        border-bottom: 1px solid #1e293b;
        flex-shrink: 0;
    }

    .nav-link {
        color: #94a3b8;
        text-decoration: none;
        padding: 8px 20px;
        border-radius: 6px;
        font-weight: 500;
        transition: 0.2s;
    }

        .nav-link:hover {
            color: #e2e8f0;
            background: rgba(51, 65, 85, 0.5);
        }

        .nav-link.active {
            color: #06b6d4;
            background: rgba(6, 182, 212, 0.1);
            border-bottom: 2px solid #06b6d4;
            border-radius: 0;
        }

    .nav-badge {
        background: rgba(6, 182, 212, 0.15);
        color: #06b6d4;
        border-radius: 10px;
        padding: 1px 8px;
        font-size: 11px;
        font-family: 'Consolas', monospace;
        margin-left: 6px;
    }

    /* EDIT: کلاس nav-right حالا فقط داخل متد C# اضافه می‌شود، نه داخل مارک‌آپ */
    .nav-right {
        margin-left: auto;
    }

    .nav-locked {
        pointer-events: none;
        opacity: 0.4;
        cursor: not-allowed;
    }

    .main-content {
        flex-grow: 1;
        overflow-y: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
        padding: 20px 40px;
        max-width: 1400px;
        width: 100%;
        margin: 0 auto;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
    }

        .main-content::-webkit-scrollbar {
            display: none;
        }

    .reconnect-modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(239, 68, 68, 0.9);
        z-index: 9999;
        justify-content: center;
        align-items: center;
    }

        .reconnect-modal.components-reconnect-show, .reconnect-modal.components-reconnect-failed {
            display: flex;
        }

    .reconnect-box {
        background: #1e293b;
        padding: 40px;
        border-radius: 12px;
        text-align: center;
    }

    .reconnect-text {
        color: #ef4444;
        font-size: 24px;
        font-weight: bold;
        margin-top: 10px;
    }

