    .app-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 40px;
        background: rgba(15, 23, 42, 0.8);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid #334155;
        flex-shrink: 0;
        position: relative;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* ── EDIT (گروه C - مرحله قبل): چراغ Connected حرفه‌ای و بزرگ‌تر ── */
    .host-pill {
        display: flex;
        align-items: center;
        gap: 12px;
        background: rgba(30, 41, 59, 0.5);
        border: 1px solid #334155;
        padding: 10px 20px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: bold;
        color: #e2e8f0;
        transition: all 0.3s ease;
        font-family: 'Consolas', monospace;
        letter-spacing: 0.5px;
    }

        .host-pill.online {
            border-color: rgba(16, 185, 129, 0.4);
            box-shadow: 0 0 12px rgba(16, 185, 129, 0.15);
        }

        .host-pill.offline {
            background: rgba(239, 68, 68, 0.15);
            border-color: rgba(239, 68, 68, 0.5);
            color: #ef4444;
            box-shadow: 0 0 20px rgba(239, 68, 68, 0.3);
            animation: offlinePillPulse 1.2s ease-in-out infinite;
        }

    @@keyframes offlinePillPulse {
        0%, 100% {
            box-shadow: 0 0 20px rgba(239, 68, 68, 0.3);
        }

        50% {
            box-shadow: 0 0 30px rgba(239, 68, 68, 0.6);
        }
    }

    .host-pill .dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        position: relative;
        flex-shrink: 0;
    }

    .host-pill.online .dot {
        background: #10b981;
        box-shadow: 0 0 10px #10b981, 0 0 20px rgba(16, 185, 129, 0.4);
        animation: onlinePulse 2.5s ease-in-out infinite;
    }

        .host-pill.online .dot::after {
            content: '';
            position: absolute;
            inset: -4px;
            border-radius: 50%;
            border: 2px solid rgba(16, 185, 129, 0.4);
            animation: onlineRing 2.5s ease-out infinite;
        }

    @@keyframes onlinePulse {
        0%, 100% {
            background: #10b981;
            box-shadow: 0 0 10px #10b981, 0 0 20px rgba(16, 185, 129, 0.4);
        }

        50% {
            background: #34d399;
            box-shadow: 0 0 16px #34d399, 0 0 28px rgba(16, 185, 129, 0.6);
        }
    }

    @@keyframes onlineRing {
        0% {
            transform: scale(0.8);
            opacity: 0.8;
        }

        100% {
            transform: scale(1.8);
            opacity: 0;
        }
    }

    .host-pill.offline .dot {
        background: #ef4444;
        box-shadow: 0 0 12px #ef4444, 0 0 24px rgba(239, 68, 68, 0.6);
        animation: offlineBlink 0.7s ease-in-out infinite;
    }

    @@keyframes offlineBlink {
        0%, 100% {
            background: #ef4444;
            box-shadow: 0 0 12px #ef4444, 0 0 24px rgba(239, 68, 68, 0.6);
            opacity: 1;
        }

        50% {
            background: #7f1d1d;
            box-shadow: 0 0 4px #ef4444;
            opacity: 0.4;
        }
    }

